---
import InstitutionalLayout from "@/layouts/InstitutionalLayout.astro";
import PhotoStrip from "@/components/institutional/PhotoStrip.astro";
import { FARECOH_PROGRAMS, FARECOH_MOBILITY, FARECOH_METHODOLOGY } from "@/data/farecoh";

const title = `Programas · FARECOH`;
const description = "Seis programas que combinan educación, arte y desarrollo comunitario para la niñez y juventud de Honduras.";

const disciplineLabels: Record<string, string> = {
  music: "Música",
  community: "Comunidad",
  arts: "Artes",
  peace: "Cultura de paz",
  exchange: "Intercambios",
  family: "Familia",
};

const disciplineAccents: Record<string, string> = {
  music: "#005082",
  community: "#0069a8",
  arts: "#0098d9",
  peace: "#0b7fa8",
  exchange: "#00507c",
  family: "#3b8fc4",
};
---

<InstitutionalLayout
  title={title}
  description={description}
  canonicalPath="/programas"
  active="programs"
>
  <section class="programs-hero">
    <div class="programs-hero__shell">
      <aside class="programs-hero__rail" aria-hidden="true">
        <span class="programs-hero__rail-eyebrow">Catálogo</span>
        <span class="programs-hero__rail-line"></span>
        <span class="programs-hero__rail-meta">{String(FARECOH_PROGRAMS.length).padStart(2, "0")} Programas</span>
      </aside>

      <div class="programs-hero__content">
        <p class="programs-hero__eyebrow">
          <span class="programs-hero__bar"></span>
          Lo que hacemos
        </p>
        <h1 class="programs-hero__title">
          Programas que combinan <em>educación, arte y desarrollo comunitario.</em>
        </h1>
        <p class="programs-hero__lead">
          {FARECOH_METHODOLOGY.lead} {FARECOH_METHODOLOGY.statement} {FARECOH_METHODOLOGY.emphasis}
        </p>
      </div>
    </div>
  </section>

  <section class="programs-list" aria-labelledby="programs-list-title">
    <div class="programs-list__shell">
      <h2 id="programs-list-title" class="sr-only">Lista de programas</h2>

      <ol class="programs-list__items" role="list">
        {FARECOH_PROGRAMS.map((program, idx) => {
          const accent = disciplineAccents[program.discipline ?? ""];
          const num = String(idx + 1).padStart(2, "0");
          return (
            <li class="programs-list__item" id={program.id} style={`--program-accent: ${accent};`}>
              <article class="programs-list__card">
                <header class="programs-list__card-head">
                  <span class="programs-list__num">{num}</span>
                  <span class="programs-list__tag">
                    {disciplineLabels[program.discipline ?? ""]}
                  </span>
                </header>

                <div class="programs-list__card-body">
                  <h3 class="programs-list__card-title">{program.title}</h3>
                  <p class="programs-list__card-category">{program.category}</p>
                  <p class="programs-list__card-desc">{program.description}</p>
                </div>

                <footer class="programs-list__card-foot">
                  <span class="programs-list__serial">No. {num} / {String(FARECOH_PROGRAMS.length).padStart(2, "0")}</span>
                </footer>
              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <PhotoStrip
    eyebrow="Galería · prácticas formativas"
    caption="La música, las artes y la comunidad en imágenes."
    photos={[
      { src: "/images/fotografias/IMG_6827.webp", alt: "Encuentro de la fundación", span: "square" },
      { src: "/images/fotografias/IMG_6830.webp", alt: "Actividad con la primera infancia", span: "tall" },
      { src: "/images/fotografias/IMG_6836.webp", alt: "Clase de música", span: "wide" },
      { src: "/images/fotografias/IMG_6838.webp", alt: "Coro infantil", span: "square" },
      { src: "/images/fotografias/IMG_6842.webp", alt: "Práctica de piano", span: "square" },
      { src: "/images/fotografias/IMG_6846.webp", alt: "Presentación en concierto", span: "tall" },
      { src: "/images/fotografias/IMG_6849.webp", alt: "Taller de artes", span: "wide" },
    ]}
  />

  <section id="intercambios" class="programs-mobility" aria-labelledby="mobility-title">
    <div class="programs-mobility__shell">
      <aside class="programs-mobility__rail" aria-hidden="true">
        <span class="programs-mobility__rail-eyebrow">Movilidad</span>
        <span class="programs-mobility__rail-line"></span>
        <span class="programs-mobility__rail-meta">Internacional</span>
      </aside>

      <div class="programs-mobility__main">
        <header class="programs-mobility__head">
          <p class="tag programs-mobility__eyebrow">
            <span class="bar" aria-hidden="true"></span>
            Intercambios y festivales
          </p>
          <h2 id="mobility-title" class="programs-mobility__title">
            {FARECOH_MOBILITY.title}
          </h2>
          <p class="programs-mobility__desc">{FARECOH_MOBILITY.description}</p>
          <span class="programs-mobility__badge">{FARECOH_MOBILITY.badge}</span>
        </header>

        <ul class="programs-mobility__destinations" role="list">
          {FARECOH_MOBILITY.destinations.map((destination, idx) => {
            const num = String(idx + 1).padStart(2, "0");
            return (
              <li class="programs-mobility__destination">
                <span class="programs-mobility__destination-num">{num}</span>
                <div class="programs-mobility__destination-body">
                  <p class="programs-mobility__destination-name">{destination.institution}</p>
                  <p class="programs-mobility__destination-country">{destination.country}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>
</InstitutionalLayout>

<style>
  .programs-hero {
    background: var(--gradient-stage);
    color: var(--color-text-on-dark);
    padding-block: clamp(7rem, 12vw, 10rem) clamp(3.5rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .programs-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 80% 20%, rgba(158, 42, 71, 0.25) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 10% 80%, rgba(59, 31, 71, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }

  .programs-hero__shell {
    position: relative;
    z-index: 1;
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .programs-hero__shell {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
  }

  .programs-hero__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) { .programs-hero__rail { display: flex; } }

  .programs-hero__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .programs-hero__rail-line {
    width: 1px;
    height: 3rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .programs-hero__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: rgba(248, 250, 252, 0.6);
  }

  .programs-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .programs-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-ruby);
  }

  .programs-hero__bar {
    display: inline-block;
    width: 2rem;
    height: 2px;
    background: var(--color-accent-ruby);
  }

  .programs-hero__title {
    margin: 0;
    color: var(--color-text-on-dark);
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .programs-hero__title em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent-ruby);
  }

  .programs-hero__lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: rgba(248, 250, 252, 0.85);
    max-width: 44rem;
  }

  /* Lista de programas */
  .programs-list {
    background: var(--color-bg-subtle);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .programs-list__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
  }

  .programs-list__item { scroll-margin-top: 6rem; }

  .programs-list__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .programs-list__item { scroll-margin-top: 6rem; }

  .programs-list__items {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  .programs-list__item {
    list-style: none;
  }

  .programs-list__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem 1.75rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-editorial);
    height: 100%;
    overflow: hidden;
    transition: box-shadow 280ms ease, transform 280ms ease, border-color 280ms ease;
  }

  .programs-list__card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--program-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 400ms ease;
  }

  .programs-list__card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
    border-color: var(--program-accent);
  }

  .programs-list__card:hover::before {
    transform: scaleY(1);
  }

  .programs-list__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .programs-list__num {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--program-accent);
  }

  .programs-list__tag {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--program-accent);
    background: color-mix(in srgb, var(--program-accent) 12%, transparent);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    align-self: center;
  }

  .programs-list__card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .programs-list__card-title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.18;
    font-weight: 700;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }

  .programs-list__card-category {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-plum);
  }

  .programs-list__card-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-primary);
  }

  .programs-list__card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border-subtle);
    flex-wrap: wrap;
  }

  .programs-list__serial {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .programs-list__badge {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    background: rgba(0, 92, 158, 0.08);
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
  }

  /* Movilidad / intercambios */
  .programs-mobility {
    background: var(--color-bg-canvas);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .programs-mobility__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .programs-mobility__shell {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
  }

  .programs-mobility__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) { .programs-mobility__rail { display: flex; } }

  .programs-mobility__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .programs-mobility__rail-line {
    width: 1px;
    height: 3rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .programs-mobility__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  .programs-mobility__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .programs-mobility__main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4rem);
    }
  }

  .programs-mobility__head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .programs-mobility__eyebrow {
    color: var(--color-accent-ruby);
    margin: 0;
  }

  .programs-mobility__title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw + 1rem, 3rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .programs-mobility__desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 38rem;
  }

  .programs-mobility__badge {
    align-self: flex-start;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-on-dark);
    background: var(--color-accent-ruby);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
  }

  .programs-mobility__destinations {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .programs-mobility__destination {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border-subtle);
    transition: padding-left 280ms ease;
  }

  .programs-mobility__destination:last-child {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .programs-mobility__destination:hover {
    padding-left: 0.5rem;
  }

  .programs-mobility__destination-num {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent-ruby);
  }

  .programs-mobility__destination-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .programs-mobility__destination-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    font-weight: 700;
    letter-spacing: -0.008em;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .programs-mobility__destination-country {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
</style>