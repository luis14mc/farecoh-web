---
import InstitutionalLayout from "@/layouts/InstitutionalLayout.astro";
import Orchestra3DCanvas from "@/components/canvas/Orchestra3DCanvas.astro";
import PhotoStrip from "@/components/institutional/PhotoStrip.astro";
import { FARECOH_PROGRAMS, FARECOH_MOBILITY } from "@/data/farecoh";

const title = `Programas · FARECOH`;
const description = "Cuatro programas activos: coros y orquestas, inclusión, primera infancia y artes visuales.";

const disciplineLabels: Record<string, string> = {
  music: "Música",
  inclusion: "Inclusión",
  "early-childhood": "Primera Infancia",
  "visual-arts": "Artes Visuales",
};
---

<InstitutionalLayout
  title={title}
  description={description}
  canonicalPath="/programas"
  active="programs"
>
  <!-- Encabezado con canvas sutil -->
  <section class="inst-section programs-header">
    <div class="programs-header__canvas" aria-hidden="true">
      <Orchestra3DCanvas />
    </div>
    <div class="inst-shell programs-header__inner">
      <p class="inst-eyebrow inst-eyebrow--inverse">
        <span class="inst-bar inst-bar--inverse" aria-hidden="true"></span>
        Programas
      </p>
      <h1 class="inst-display inst-display--hero programs-header__title">
        Cuatro disciplinas, una sola <em>coherencia pedagógica.</em>
      </h1>
      <p class="inst-body--inverse programs-header__lead">
        Cada programa responde a un momento del desarrollo humano: la primera
        escucha, la inclusión radical, el dominio instrumental y la expresión
        plástica.
      </p>
    </div>
  </section>

  <!-- Lista editorial de programas -->
  <section class="inst-section programs-list" aria-labelledby="programs-list-title">
    <div class="inst-shell">
      <h2 id="programs-list-title" class="sr-only">Lista de programas</h2>

      <ol class="programs-list__items" role="list">
        {
          FARECOH_PROGRAMS.map((program, idx) => (
            <li class="programs-list__item">
              <article class="programs-list__card">
                <header class="programs-list__card-head">
                  <span class="inst-mono-index" aria-hidden="true">{program.index}</span>
                  <span class="inst-eyebrow inst-eyebrow--accent">
                    {disciplineLabels[program.discipline]}
                  </span>
                </header>

                <div class="programs-list__card-body">
                  <h3 class="inst-display inst-display--lg programs-list__card-title">
                    {program.title}
                  </h3>
                  <p class="inst-eyebrow inst-eyebrow--ink programs-list__card-category">
                    {program.category}
                  </p>
                  <p class="inst-body">{program.description}</p>
                  <span class="inst-badge">{program.badge}</span>
                </div>

                <footer class="programs-list__card-foot">
                  <span class="inst-mono programs-list__card-serial">
                    No. {String(idx + 1).padStart(2, "0")} / 04
                  </span>
                  <a href="/sobre-nosotros" class="inst-link">
                    Conocer el marco institucional
                    <span aria-hidden="true">→</span>
                  </a>
                </footer>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Galería fotográfica de los programas -->
  <PhotoStrip
    eyebrow="Galería · prácticas formativas"
    caption="La música, la inclusión y la plástica en imágenes."
    photos={[
      { src: "/images/fotografias/IMG_6827.webp", alt: "Ensayo coral", span: "square" },
      { src: "/images/fotografias/IMG_6830.webp", alt: "Práctica orquestal", span: "tall" },
      { src: "/images/fotografias/IMG_6836.webp", alt: "Sesión de estimulación", span: "wide" },
      { src: "/images/fotografias/IMG_6838.webp", alt: "Coro infantil", span: "square" },
      { src: "/images/fotografias/IMG_6842.webp", alt: "Taller de plástica", span: "square" },
      { src: "/images/fotografias/IMG_6846.webp", alt: "Manos Blancas en concierto", span: "tall" },
      { src: "/images/fotografias/IMG_6849.webp", alt: "Repertorio contemporáneo", span: "wide" },
    ]}
  />

  <!-- Intercambios & becas -->
  <section
    id="intercambios"
    class="inst-section programs-mobility"
    aria-labelledby="mobility-title"
  >
    <div class="inst-shell programs-mobility__grid">
      <div class="programs-mobility__head">
        <p class="inst-eyebrow inst-eyebrow--accent">
          <span class="inst-bar inst-bar--accent" aria-hidden="true"></span>
          05 — Intercambios
        </p>
        <h2 id="mobility-title" class="inst-display inst-display--xl programs-mobility__title">
          {FARECOH_MOBILITY.title}
        </h2>
        <p class="inst-body--lead">{FARECOH_MOBILITY.description}</p>
        <span class="inst-badge">{FARECOH_MOBILITY.badge}</span>
      </div>

      <ul class="programs-mobility__destinations" role="list">
        {
          FARECOH_MOBILITY.destinations.map((destination, idx) => (
            <li class="programs-mobility__destination">
              <span class="inst-mono programs-mobility__destination-index">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <div>
                <p class="programs-mobility__destination-name">{destination.institution}</p>
                <p class="inst-body--small">{destination.country}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</InstitutionalLayout>

<style>
  .programs-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 20% 30%, rgba(79, 195, 245, 0.16) 0%, transparent 55%),
      linear-gradient(180deg, #061a33 0%, #0b2545 100%);
    color: var(--color-inst-ivory);
    padding-top: clamp(5.5rem, 10vw, 10rem);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .programs-header__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.85;
  }

  .programs-header__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60rem;
  }

  .programs-header__title {
    margin: 0;
    color: var(--color-inst-ivory);
    max-width: 22ch;
  }

  .programs-header__title em {
    font-style: italic;
    font-weight: 700;
    color: var(--color-inst-cyan);
    font-variation-settings: "wdth" 110, "wght" 700;
  }

  .programs-header__lead {
    margin: 0;
    max-width: 44rem;
  }

  .programs-list {
    background: var(--color-inst-ivory-bright);
  }

  .programs-list__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .programs-list__items {
      gap: 2rem;
    }
  }

  .programs-list__item:nth-child(odd) {
    margin-right: 0;
  }

  .programs-list__item:nth-child(even) {
    margin-left: 0;
  }

  @media (min-width: 1024px) {
    .programs-list__item:nth-child(odd) {
      margin-right: clamp(0px, 8vw, 6rem);
    }

    .programs-list__item:nth-child(even) {
      margin-left: clamp(0px, 8vw, 6rem);
    }
  }

  .programs-list__card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background: var(--color-inst-ivory);
    border: 1px solid color-mix(in srgb, var(--color-inst-deep) 10%, transparent);
    border-left: 3px solid var(--color-inst-deep);
  }

  @media (min-width: 768px) {
    .programs-list__card {
      grid-template-columns: minmax(0, 5.5rem) minmax(0, 1fr) auto;
      align-items: start;
      gap: 2rem;
    }
  }

  .programs-list__card-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .programs-list__card-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .programs-list__card-title {
    margin: 0;
    color: var(--color-inst-deep);
    max-width: 24ch;
    text-wrap: balance;
  }

  .programs-list__card-category {
    color: var(--color-inst-graphite-soft);
  }

  .programs-list__card-foot {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-inst-deep) 10%, transparent);
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .programs-list__card-foot {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      grid-column: 2 / -1;
    }
  }

  .programs-list__card-serial {
    font-size: 0.75rem;
    color: var(--color-inst-graphite-soft);
    letter-spacing: 0.12em;
  }

  /* Movilidad */
  .programs-mobility {
    background:
      linear-gradient(180deg, var(--color-inst-ivory) 0%, var(--color-inst-ivory-bright) 100%);
  }

  .programs-mobility__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .programs-mobility__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem 6rem;
    }
  }

  .programs-mobility__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .programs-mobility__head .inst-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .programs-mobility__title {
    margin: 0;
    max-width: 20ch;
    color: var(--color-inst-deep);
  }

  .programs-mobility__destinations {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .programs-mobility__destination {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-inst-deep) 14%, transparent);
  }

  @media (min-width: 640px) {
    .programs-mobility__destination {
      display: grid;
      grid-template-columns: 4rem 1fr;
      gap: 1.5rem;
      align-items: baseline;
      padding: 1.5rem 0;
    }
  }

  .programs-mobility__destination:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-inst-deep) 14%, transparent);
  }

  .programs-mobility__destination-index {
    font-size: 0.75rem;
    color: var(--color-inst-cyan-deep);
    letter-spacing: 0.1em;
  }

  .programs-mobility__destination-name {
    margin: 0 0 0.25rem;
    font-family: var(--font-inst-display);
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--color-inst-deep);
    letter-spacing: -0.015em;
  }
</style>
