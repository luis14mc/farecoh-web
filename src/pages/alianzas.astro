---
import { seoPages } from "@/data/seo";
import InstitutionalLayout from "@/layouts/InstitutionalLayout.astro";
import { FARECOH_PARTNERS } from "@/data/farecoh";

const { title, description } = seoPages.partners;

const regionLabels: Record<string, string> = {
  multilateral: "Cooperación multilateral",
  americas: "Américas",
  europe: "Europa",
  "central-america": "Centroamérica",
};

const regionColors: Record<string, string> = {
  multilateral: "var(--color-brand-blue)",
  americas: "var(--color-brand-cyan)",
  europe: "var(--color-accent-plum)",
  "central-america": "var(--color-accent-ruby)",
};

const partnerCount = String(FARECOH_PARTNERS.length).padStart(2, "0");
---

<InstitutionalLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: "Alianzas", path: "/alianzas" }]}
  canonicalPath="/alianzas"
  active="partners"
>
  <section class="partners-hero">
    <div class="partners-hero__shell">
      <aside class="partners-hero__rail" aria-hidden="true">
        <span class="partners-hero__rail-eyebrow">Cooperación</span>
        <span class="partners-hero__rail-line"></span>
        <span class="partners-hero__rail-meta">Internacional</span>
      </aside>

      <div class="partners-hero__content">
        <p class="partners-hero__eyebrow">
          <span class="partners-hero__bar"></span>
          Alianzas estratégicas
        </p>
        <h1 class="partners-hero__title">
          Cinco aliados, una <em>red de cooperación</em> sostenida.
        </h1>
        <p class="partners-hero__lead">
          La fundación opera en articulación con organismos multilaterales,
          agencias nacionales de cooperación y redes artísticas internacionales.
        </p>
      </div>
    </div>
  </section>

  <section class="partners-grid" aria-labelledby="partners-grid-title">
    <div class="partners-grid__shell">
      <h2 id="partners-grid-title" class="sr-only">Listado de aliados</h2>

      <aside class="partners-grid__rail" aria-hidden="true">
        <span class="partners-grid__rail-eyebrow">Red</span>
        <span class="partners-grid__rail-num">{partnerCount}</span>
        <span class="partners-grid__rail-line"></span>
        <span class="partners-grid__rail-meta">Cooperantes</span>
      </aside>

      <ol class="partners-grid__list" role="list">
        {FARECOH_PARTNERS.map((partner, idx) => {
          const num = String(idx + 1).padStart(2, "0");
          const regionColor = regionColors[partner.region ?? ""] ?? "var(--color-brand-blue)";
          return (
            <li class="partners-grid__item" style={`--region-accent: ${regionColor};`}>
              <span class="partners-grid__num">{num}</span>
              <div class="partners-grid__copy">
                <h3 class="partners-grid__name">{partner.name}</h3>
                {partner.entity && <p class="partners-grid__entity">{partner.entity}</p>}
                {partner.type && <p class="partners-grid__type">{partner.type}</p>}
              </div>
              <span class="partners-grid__region">
                {regionLabels[partner.region ?? ""] ?? partner.region}
              </span>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="partners-cta">
    <div class="partners-cta__shell">
      <div class="partners-cta__content">
        <p class="partners-cta__eyebrow">
          <span class="partners-cta__bar"></span>
          ¿Sumarse a la red?
        </p>
        <h2 class="partners-cta__title">
          ¿Su organización busca articularse con un <em>programa artístico</em> educativo?
        </h2>
      </div>
      <a href="mailto:info@farecoh.org" class="btn">
        Escribir al equipo
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</InstitutionalLayout>

<style>
  .partners-hero {
    background: var(--color-bg-subtle);
    padding-block: clamp(7rem, 12vw, 10rem) clamp(3rem, 5vw, 4rem);
  }

  .partners-hero__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .partners-hero__shell {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
  }

  .partners-hero__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) { .partners-hero__rail { display: flex; } }

  .partners-hero__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .partners-hero__rail-line {
    width: 1px;
    height: 3rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .partners-hero__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  .partners-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .partners-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-ruby);
  }

  .partners-hero__bar {
    display: inline-block;
    width: 2rem;
    height: 2px;
    background: var(--color-accent-ruby);
  }

  .partners-hero__title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.8vw, 3.5rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .partners-hero__title em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--color-brand-blue);
  }

  .partners-hero__lead {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 44rem;
  }

  /* Grid de partners */
  .partners-grid {
    background: var(--color-bg-canvas);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .partners-grid__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .partners-grid__shell {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
  }

  .partners-grid__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) { .partners-grid__rail { display: flex; } }

  .partners-grid__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .partners-grid__rail-num {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-accent-ruby);
  }

  .partners-grid__rail-line {
    width: 1px;
    height: 3rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .partners-grid__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  .partners-grid__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .partners-grid__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .partners-grid__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    gap: clamp(0.85rem, 1.5vw, 1.25rem);
    align-items: center;
    padding: 1.25rem 1.1rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--region-accent);
    border-radius: var(--radius-sm) var(--radius-md) var(--radius-md) var(--radius-sm);
    transition: box-shadow 280ms ease, transform 280ms ease;
  }

  .partners-grid__item:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateX(3px);
  }

  .partners-grid__num {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .partners-grid__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .partners-grid__name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.008em;
    color: var(--color-text-primary);
  }

  .partners-grid__entity {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .partners-grid__type {
    margin: 0.15rem 0 0;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-plum);
  }

  .partners-grid__region {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--region-accent);
    background: color-mix(in srgb, var(--region-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--region-accent) 25%, transparent);
    align-self: center;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  /* CTA — Fondo Ciruela (gala / concierto) */
  .partners-cta {
    background: var(--gradient-plum);
    color: var(--color-text-on-dark);
    padding-block: clamp(6rem, 10vw, 9rem);
    position: relative;
    overflow: hidden;
  }

  .partners-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 80% 20%, rgba(158, 42, 71, 0.18) 0%, transparent 60%);
    pointer-events: none;
  }

  .partners-cta__shell {
    position: relative;
    z-index: 1;
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .partners-cta__shell {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .partners-cta__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .partners-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-ruby);
  }

  .partners-cta__bar {
    display: inline-block;
    width: 2rem;
    height: 2px;
    background: var(--color-accent-ruby);
  }

  .partners-cta__title {
    margin: 0;
    color: var(--color-text-on-dark);
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 28ch;
  }

  .partners-cta__title em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent-ruby);
  }

  .partners-cta .btn {
    background: var(--color-accent-ruby);
    color: #FFFFFF;
    border-color: var(--color-accent-ruby);
    border-radius: var(--radius-pill);
  }

  .partners-cta .btn:hover {
    background: var(--color-accent-ruby-dark);
    color: #FFFFFF;
    border-color: var(--color-accent-ruby-dark);
    box-shadow: var(--shadow-ruby);
  }
</style>