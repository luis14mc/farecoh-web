---
import InstitutionalLayout from "@/layouts/InstitutionalLayout.astro";
import PhotoStrip from "@/components/institutional/PhotoStrip.astro";
import {
  FARECOH_CONTEXT,
  FARECOH_HISTORY,
  FARECOH_IMPACT,
  FARECOH_IMPORTANCE,
  FARECOH_METADATA,
  FARECOH_METHODOLOGY,
  FARECOH_NARRATIVE,
  FARECOH_WHY_SUPPORT,
  INSTITUTIONAL_STATS,
} from "@/data/farecoh";

const title = `Sobre nosotros · ${FARECOH_METADATA.acronym}`;
const description = FARECOH_NARRATIVE.about;
const foundationYear = FARECOH_METADATA.established;
const yearsOfService = new Date().getFullYear() - foundationYear;
const yearCount = String(yearsOfService).padStart(2, "0");
---

<InstitutionalLayout
  title={title}
  description={description}
  canonicalPath="/sobre-nosotros"
  active="about"
>
  <section class="about-header">
    <div class="about-header__shell">
      <aside class="about-header__rail" aria-hidden="true">
        <span class="about-header__rail-eyebrow">Identidad</span>
        <span class="about-header__rail-line"></span>
        <span class="about-header__rail-meta">Sección 02</span>
      </aside>

      <div class="about-header__content">
        <p class="about-header__eyebrow">
          <span class="about-header__bar"></span>
          Sobre la fundación
        </p>
        <h1 class="about-header__title">
          Transformando vidas a través del <em>arte, la educación</em> y la esperanza.
        </h1>
        <p class="about-header__lead">
          {FARECOH_CONTEXT.problem}
        </p>
      </div>

      <aside class="about-header__number" aria-hidden="false">
        <span class="about-header__number-val">{yearCount}</span>
        <span class="about-header__number-meta">años<br />formando</span>
      </aside>
    </div>
  </section>

  <hr class="about-rule" />

  <section class="about-manifesto">
    <div class="about-manifesto__shell">
      <p class="tag about-manifesto__eyebrow">
        <span class="bar" aria-hidden="true"></span>
        Quiénes somos
      </p>
      <blockquote class="about-manifesto__quote">
        <span class="about-manifesto__quote-mark" aria-hidden="true">&ldquo;</span>
        {FARECOH_NARRATIVE.about}
      </blockquote>
      <p class="about-manifesto__after">{FARECOH_CONTEXT.purpose}</p>
    </div>
  </section>

  <section class="about-mv" aria-labelledby="mv-title">
    <div class="about-mv__shell">
      <h2 id="mv-title" class="sr-only">Misión y visión</h2>

      <div class="about-mv__grid">
        <article class="about-mv__block">
          <header class="about-mv__head">
            <span class="about-mv__num">01</span>
            <h3 class="about-mv__label">Misión</h3>
          </header>
          <p class="about-mv__body">{FARECOH_NARRATIVE.mission}</p>
        </article>

        <article class="about-mv__block">
          <header class="about-mv__head">
            <span class="about-mv__num">02</span>
            <h3 class="about-mv__label">Visión</h3>
          </header>
          <p class="about-mv__body">{FARECOH_NARRATIVE.vision}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ab-story" aria-labelledby="historia-title" id="historia">
    <div class="ab-shell ab-story__grid">
      <div class="ab-story__year" aria-hidden="true">
        <span>Desde</span>
        <strong>{foundationYear}</strong>
        <ul>{FARECOH_HISTORY.regions.map((region) => <li>{region}</li>)}</ul>
      </div>
      <div>
        <p class="ab-eyebrow"><span aria-hidden="true"></span>Nuestra historia</p>
        <h2 id="historia-title" class="ab-title">{FARECOH_HISTORY.title}</h2>
        <div class="ab-prose">
          {FARECOH_HISTORY.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <p class="ab-story__closing">{FARECOH_HISTORY.closing}</p>
      </div>
    </div>
  </section>

  <section class="ab-why" aria-labelledby="importancia-title">
    <div class="ab-shell">
      <p class="ab-eyebrow ab-eyebrow--light"><span aria-hidden="true"></span>Honduras</p>
      <h2 id="importancia-title" class="ab-title ab-title--light">¿Por qué es importante FARECOH para Honduras?</h2>
      <ol class="ab-why__list">
        {FARECOH_IMPORTANCE.reasons.map((reason, index) => (
          <li><span class="ab-why__num">{String(index + 1).padStart(2, "0")}</span><p>{reason}</p></li>
        ))}
      </ol>
      <p class="ab-why__body">{FARECOH_IMPORTANCE.body}</p>
    </div>
  </section>

  <section class="ab-method" aria-labelledby="metodologia-title">
    <div class="ab-shell ab-method__grid">
      <div>
        <p class="ab-eyebrow"><span aria-hidden="true"></span>Nuestra metodología</p>
        <h2 id="metodologia-title" class="ab-title">{FARECOH_METHODOLOGY.lead}</h2>
        <p class="ab-lead">{FARECOH_METHODOLOGY.body}</p>
      </div>
      <figure class="ab-method__card">
        <p>{FARECOH_METHODOLOGY.statement}</p>
        <strong>{FARECOH_METHODOLOGY.emphasis}</strong>
      </figure>
    </div>
  </section>

  <section class="ab-impact" aria-labelledby="impacto-title">
    <div class="ab-shell">
      <p class="ab-eyebrow"><span aria-hidden="true"></span>Nuestro impacto</p>
      <h2 id="impacto-title" class="ab-title">Contribuimos a…</h2>
      <p class="ab-lead">{FARECOH_IMPACT.intro}</p>
      <ul class="ab-impact__grid">
        {FARECOH_IMPACT.contributions.map((item) => (
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m8 12 3 3 5-6" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PhotoStrip
    eyebrow="Galería institucional"
    caption={`Desde ${foundationYear}, formando con el arte en Honduras.`}
    photos={[
      { src: "/images/fotografias/IMG_6835.webp", alt: "Orquesta en concierto", span: "wide" },
      { src: "/images/fotografias/IMG_6837.webp", alt: "Coro institucional", span: "square" },
      { src: "/images/fotografias/IMG_6841.webp", alt: "Trabajo con docentes", span: "square" },
      { src: "/images/fotografias/IMG_6845.webp", alt: "Jóvenes en escena", span: "tall" },
      { src: "/images/fotografias/IMG_6848.webp", alt: "Acto institucional", span: "wide" },
      { src: "/images/fotografias/IMG_6829.webp", alt: "Práctica pedagógica", span: "square" },
    ]}
  />

  <section class="about-foundation">
    <div class="about-foundation__shell">
      <aside class="about-foundation__rail" aria-hidden="true">
        <span class="about-foundation__rail-eyebrow">Cifras</span>
        <span class="about-foundation__rail-line"></span>
        <span class="about-foundation__rail-meta">Sección 03</span>
      </aside>

      <div class="about-foundation__main">
        <header class="about-foundation__head">
          <p class="tag about-foundation__eyebrow">
            <span class="bar" aria-hidden="true"></span>
            Datos fundamentales
          </p>
          <h2 class="about-foundation__title">FARECOH en <em>cifras</em>.</h2>
        </header>

        <dl class="about-foundation__grid">
          <div class="about-foundation__cell">
            <span class="about-foundation__cell-rule" aria-hidden="true"></span>
            <dt class="about-foundation__label">Años de trayectoria</dt>
            <dd class="about-foundation__value">+{yearsOfService}</dd>
            <dd class="about-foundation__caption">Fundada en {foundationYear} · {FARECOH_METADATA.legalSeat}</dd>
          </div>
          {INSTITUTIONAL_STATS.map((stat) => (
            <div class="about-foundation__cell">
              <span class="about-foundation__cell-rule" aria-hidden="true"></span>
              <dt class="about-foundation__label">{stat.label}</dt>
              <dd class="about-foundation__value">
                {stat.label === "Años de trayectoria" ? `+${yearsOfService}` : stat.value}
              </dd>
              <dd class="about-foundation__caption">{stat.caption}</dd>
            </div>
          ))}

        </dl>
      </div>
    </div>
  </section>

  <section class="ab-support" id="apoyar" aria-labelledby="apoyar-title">
    <div class="ab-shell ab-support__grid">
      <div>
        <p class="ab-eyebrow"><span aria-hidden="true"></span>Únase a nuestra misión</p>
        <h2 id="apoyar-title" class="ab-title">¿Por qué apoyar a FARECOH?</h2>
        <ul class="ab-support__reasons">
          {FARECOH_WHY_SUPPORT.reasons.map((reason) => <li>{reason}</li>)}
        </ul>
        <p class="ab-lead">{FARECOH_WHY_SUPPORT.body}</p>
        <p class="ab-lead">{FARECOH_WHY_SUPPORT.join}</p>
        <div class="ab-support__actions">
          <a class="ab-btn" href="mailto:info@farecoh.org?subject=Quiero%20apoyar%20a%20FARECOH">Quiero apoyar</a>
          <a class="ab-btn ab-btn--ghost" href="/eventos">Ver conciertos</a>
        </div>
      </div>
      <figure class="ab-support__quote">
        <blockquote>{FARECOH_CONTEXT.quote}</blockquote>
        <figcaption>{FARECOH_CONTEXT.pillars}</figcaption>
      </figure>
    </div>
  </section>

  <section class="about-cta">
    <div class="about-cta__shell">
      <h2 class="about-cta__title">Conoce los <em>programas</em> que sostienen esta misión.</h2>
      <a href="/programas" class="btn btn--donate">
        Ver programas
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</InstitutionalLayout>

<style>
  .about-header {
    padding-block: clamp(7rem, 12vw, 10rem) clamp(3rem, 5vw, 4rem);
    background: var(--color-bg-canvas);
  }

  .about-header__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .about-header__shell {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  .about-header__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .about-header__rail {
      display: flex;
    }
  }

  .about-header__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .about-header__rail-line {
    width: 1px;
    height: 3rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .about-header__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  .about-header__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-header__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-ruby);
  }

  .about-header__bar {
    display: inline-block;
    width: 2rem;
    height: 2px;
    background: var(--color-accent-ruby);
  }

  .about-header__title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.8vw, 3.75rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .about-header__title em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--color-brand-blue);
  }

  .about-header__lead {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 38rem;
  }

  .about-header__number {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--color-text-primary);
  }

  .about-header__number-val {
    font-family: var(--font-heading);
    font-size: clamp(4.5rem, 10vw, 7.5rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-accent-ruby);
  }

  .about-header__number-meta {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    line-height: 1.2;
    text-align: left;
  }

  .about-rule {
    border: 0;
    border-top: 1px solid var(--color-border-subtle);
    margin: 0 auto;
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
  }

  /* Manifiesto */
  .about-manifesto {
    background: var(--color-bg-subtle);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .about-manifesto__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 56rem;
  }

  .about-manifesto__eyebrow {
    color: var(--color-accent-ruby);
    margin: 0;
  }

  .about-manifesto__quote {
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 2px solid var(--color-accent-ruby);
    position: relative;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2vw + 0.5rem, 1.85rem);
    line-height: 1.4;
    font-style: italic;
    color: var(--color-text-primary);
    text-wrap: balance;
    letter-spacing: -0.005em;
  }

  .about-manifesto__quote-mark {
    position: absolute;
    top: -1rem;
    left: 0;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: var(--color-accent-ruby);
    color: var(--color-text-on-dark);
    font-family: var(--font-editorial);
    font-size: 1.75rem;
    line-height: 1;
  }

  /* Misión & Visión */
  .about-mv {
    background: var(--color-bg-canvas);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .about-mv__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
  }

  .about-mv__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .about-mv__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  .about-mv__block {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem 1.75rem 2rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-editorial);
  }

  .about-mv__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--color-border-subtle);
  }

  .about-mv__num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-accent-ruby);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .about-mv__label {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  .about-mv__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-primary);
  }

  /* Datos fundamentales */
  .about-foundation {
    background: var(--color-bg-subtle);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .about-foundation__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .about-foundation__shell {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  .about-foundation__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .about-foundation__rail {
      display: flex;
    }
  }

  .about-foundation__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .about-foundation__rail-line {
    width: 1px;
    height: 3rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .about-foundation__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  .about-foundation__main {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .about-foundation__head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-foundation__eyebrow {
    color: var(--color-accent-ruby);
    margin: 0;
  }

  .about-foundation__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw + 1rem, 3rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .about-foundation__title em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent-ruby);
  }

  .about-foundation__grid {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .about-foundation__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .about-foundation__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .about-foundation__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.25rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    transition: box-shadow 280ms ease, transform 280ms ease, border-color 280ms ease;
  }

  .about-foundation__cell:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
    border-color: var(--color-accent-ruby);
  }

  .about-foundation__cell-rule {
    display: block;
    width: 2rem;
    height: 3px;
    background: var(--color-accent-ruby);
    margin-bottom: 0.5rem;
  }

  .about-foundation__label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .about-foundation__value {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0.35rem 0 0.5rem;
  }

  .about-foundation__seat {
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin: 0.35rem 0 0.5rem;
  }

  .about-foundation__caption {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* CTA — Fondo Rubí */
  .about-cta {
    background: var(--gradient-ruby);
    color: var(--color-text-on-dark);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .about-cta__shell {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-cta__shell {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .about-cta__title {
    margin: 0;
    color: var(--color-text-on-dark);
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 24ch;
