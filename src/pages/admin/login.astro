---
import AdminAuthLayout from "@/layouts/AdminAuthLayout.astro";
import { getCurrentUser, isAuthConfigured } from "@/lib/auth";
import { requireAdminAccess, roleHomePath } from "@/lib/rbac";

const authConfigured = isAuthConfigured();
const authError = Astro.url.searchParams.get("error");
const redirectParam = Astro.url.searchParams.get("redirect");
const safeRedirect =
  redirectParam && redirectParam.startsWith("/admin") && !redirectParam.startsWith("//")
    ? redirectParam
    : "/admin";

if (authConfigured && Astro.request.method === "GET") {
  const access = await requireAdminAccess(Astro, safeRedirect).catch(() => ({
    ok: false as const,
    profile: null,
    reason: "unauthenticated" as const,
  }));

  if (access.ok && access.profile) {
    return Astro.redirect(safeRedirect);
  }

  if (access.reason === "no_profile") {
    return Astro.redirect("/admin/no-autorizado");
  }

  if (access.reason === "unauthorized" && access.profile) {
    return Astro.redirect(roleHomePath[access.profile.role] ?? "/admin/no-autorizado");
  }
}
---

<AdminAuthLayout
  title="Acceso Administrativo | FARECOH"
  authConfigured={authConfigured}
>
  <main class="flex min-h-screen items-center justify-center px-margin py-12">
    <section class="w-full max-w-md rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm">
      <p class="label-caps text-primary">Panel administrativo</p>
      <h1 class="mt-2 headline-md text-on-surface">Iniciar sesión</h1>
      <p class="mt-2 body-md text-on-surface-variant">Use su cuenta autorizada de FARECOH.</p>

      {!authConfigured && (
        <p class="mt-4 rounded bg-yellow-100 p-3 body-md text-yellow-800">
          La autenticación no está configurada. Defina DATABASE_URL y SESSION_SECRET en el servidor.
        </p>
      )}

      {authError && (
        <p class="mt-4 rounded bg-red-100 p-3 body-md text-red-700">{authError}</p>
      )}

      <form
        id="login-form"
        method="POST"
        action={`/api/auth/login?redirect=${encodeURIComponent(safeRedirect)}`}
        class="mt-6 space-y-4"
      >
        <label class="block">
          <span class="label-caps text-on-surface-variant">Correo</span>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            disabled={!authConfigured}
            class="mt-2 w-full rounded border border-outline-variant bg-surface px-3 py-3 body-md outline-none focus:border-primary disabled:cursor-not-allowed disabled:opacity-60"
          />
        </label>
        <label class="block">
          <span class="label-caps text-on-surface-variant">Contraseña</span>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            disabled={!authConfigured}
            class="mt-2 w-full rounded border border-outline-variant bg-surface px-3 py-3 body-md outline-none focus:border-primary disabled:cursor-not-allowed disabled:opacity-60"
          />
        </label>
        <button
          id="login-button"
          disabled={!authConfigured}
          class="w-full rounded bg-primary px-4 py-3 label-caps text-on-primary transition-colors hover:bg-secondary disabled:cursor-not-allowed disabled:opacity-60"
          type="submit"
        >
          Entrar
        </button>
      </form>

      <p id="login-message" class="mt-4 hidden rounded p-3 body-md"></p>

      <div class="mt-6 text-center">
        <p class="body-sm text-on-surface-variant">
          ¿Olvidó su contraseña? Contacte al super administrador para restablecerla.
        </p>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement | null;
    const button = document.getElementById("login-button") as HTMLButtonElement | null;
    const message = document.getElementById("login-message");
    const emailInput = document.getElementById("email") as HTMLInputElement | null;
    const passwordInput = document.getElementById("password") as HTMLInputElement | null;

    function showMessage(text: string, type: "error" | "success" = "error") {
      if (!message) return;
      message.textContent = text;
      message.className = `mt-4 rounded p-3 body-md ${type === "error" ? "bg-red-100 text-red-700" : "bg-green-100 text-green-700"}`;
      message.classList.remove("hidden");
    }

    function getRedirectTarget(): string {
      const param = new URLSearchParams(window.location.search).get("redirect");
      if (param && param.startsWith("/admin") && !param.startsWith("//")) {
        return param;
      }
      return "/admin";
    }

    if (window.location.search) {
      const params = new URLSearchParams(window.location.search);
      if (params.has("email") || params.has("password")) {
        window.location.assign("/admin/login");
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!button || !emailInput || !passwordInput) return;

      const email = emailInput.value.trim();
      const password = passwordInput.value;
      if (!email || !password) {
        showMessage("Ingrese correo y contraseña.");
        return;
      }

      button.disabled = true;
      const originalText = button.textContent;
      button.textContent = "Validando...";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ email, password, redirect: getRedirectTarget() }),
          credentials: "same-origin",
        });

        const data = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          redirect?: string;
        };

        passwordInput.value = "";
        if (!response.ok || !data.ok) {
          showMessage(data.error ?? "Credenciales inválidas.");
          button.disabled = false;
          button.textContent = originalText;
          return;
        }

        const target = data.redirect && data.redirect.startsWith("/admin") ? data.redirect : "/admin";
        window.location.assign(target);
      } catch (err) {
        console.error(err);
        showMessage("No se pudo contactar al servidor. Intente de nuevo.");
        button.disabled = false;
        button.textContent = originalText;
      }
    });
  </script>
</AdminAuthLayout>
