---
import AdminAuthLayout from "@/layouts/AdminAuthLayout.astro";
import { getStaffProfile, isAuthConfigured } from "@/lib/auth";
import { roleHomePath } from "@/lib/rbac";

const authConfigured = isAuthConfigured();
const authError = Astro.url.searchParams.get("error");
const redirectParam = Astro.url.searchParams.get("redirect");
const safeRedirect =
  redirectParam && redirectParam.startsWith("/admin") && !redirectParam.startsWith("//")
    ? redirectParam
    : "/admin";

if (Astro.request.method === "GET") {
  const profile = await getStaffProfile(Astro);
  if (profile) {
    return Astro.redirect(safeRedirect);
  }
}
---

<AdminAuthLayout
  title="Acceso Administrativo | FARECOH"
  authConfigured={authConfigured}
>
  <main class="flex min-h-screen items-center justify-center px-margin py-12">
    <section class="w-full max-w-md rounded-2xl border border-outline-variant/60 bg-surface-container-lowest p-8 shadow-xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-bold uppercase tracking-wider text-primary">
        Panel administrativo
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-on-surface">Iniciar sesión</h1>
      <p class="mt-1 text-sm text-on-surface-variant">Use su cuenta autorizada de FARECOH (PostgreSQL).</p>

      {authError && (
        <p class="mt-4 rounded-lg bg-red-100 p-3 text-sm text-red-700">{authError}</p>
      )}

      <form id="login-form" class="mt-6 space-y-4">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Correo electrónico</span>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-1.5 w-full rounded-xl border border-outline-variant bg-surface px-4 py-3 text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20"
            placeholder="admin@farecoh.org"
          />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Contraseña</span>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="mt-1.5 w-full rounded-xl border border-outline-variant bg-surface px-4 py-3 text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20"
          />
        </label>
        <button
          id="login-button"
          class="w-full rounded-xl bg-primary px-4 py-3.5 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all hover:bg-brand-500 hover:shadow-md active:scale-98 disabled:cursor-not-allowed disabled:opacity-60"
          type="submit"
        >
          Entrar
        </button>
      </form>

      <p id="login-message" class="mt-4 hidden rounded-xl p-3 text-sm"></p>
    </section>
  </main>

  <script>
    const loginForm = document.getElementById("login-form") as HTMLFormElement | null;
    const loginButton = document.getElementById("login-button") as HTMLButtonElement | null;
    const message = document.getElementById("login-message");
    const emailInput = document.getElementById("email") as HTMLInputElement | null;
    const passwordInput = document.getElementById("password") as HTMLInputElement | null;

    function getRedirectTarget(): string {
      const param = new URLSearchParams(window.location.search).get("redirect");
      if (param && param.startsWith("/admin") && !param.startsWith("//")) {
        return param;
      }
      return "/admin";
    }

    function showMessage(text: string, type = "error") {
      if (!message) return;
      message.textContent = text;
      message.className = `mt-4 rounded-xl p-3 text-sm font-medium ${type === "error" ? "bg-red-50 text-red-700 border border-red-200" : "bg-green-50 text-green-700 border border-green-200"}`;
      message.classList.remove("hidden");
    }

    loginForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!loginButton || !emailInput || !passwordInput) return;

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!email || !password) {
        showMessage("Ingrese su correo y contraseña.");
        return;
      }

      loginButton.disabled = true;
      loginButton.textContent = "Validando...";

      try {
        const response = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, password }),
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          showMessage(data.error || "Credenciales inválidas.");
          loginButton.disabled = false;
          loginButton.textContent = "Entrar";
          return;
        }

        window.location.assign(getRedirectTarget());
      } catch (err) {
        showMessage("Error de conexión al servidor.");
        loginButton.disabled = false;
        loginButton.textContent = "Entrar";
      }
    });
  </script>
</AdminAuthLayout>
