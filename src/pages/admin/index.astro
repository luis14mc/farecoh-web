---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminPage from "@/components/admin/ui/AdminPage.astro";
import { AdminPageHeader } from "@/components/admin/react/AdminPageHeader";
import { DashboardStats, ProgressChartCard } from "@/components/admin/react/DashboardStats";
import { RecentCheckinsTable, RecentReservationsTable } from "@/components/admin/react/DashboardTables";
import { SalesHistoryTable } from "@/components/admin/react/SalesHistoryTable";
import { TicketSearchQuick } from "@/components/admin/react/TicketSearchQuick";
import type { UserProfile } from "@/lib/auth";
import { formatSiteCurrency, formatSiteDate, formatSiteNumber } from "@/lib/locale";
import { getPinkFloydEventFallback } from "@/lib/events";
import { countTicketsByStatus, countTicketsSold, resolveGrossRevenue } from "@/services/admin-stats";
import { queryRows } from "@/lib/db";

const staffProfile = Astro.locals.staffProfile as UserProfile | undefined;
const authConfigured = true;
const currentDate = formatSiteDate(new Date(), { month: "short", day: "numeric", year: "numeric" });
const CAPACITY = getPinkFloydEventFallback().total_tickets;

let rawSales: Array<{
  amount: number | string;
  seller_name: string | null;
  created_at: string;
  payment_method: string | null;
  sales_point: string | null;
  ticket_code: string | null;
  buyer_name: string | null;
  buyer_phone: string | null;
  buyer_email: string | null;
}> = [];

let tickets: Array<{ status: string }> = [];
let reservations: Array<{ ticket_code: string; buyer_name: string | null; buyer_phone: string | null }> = [];
let checkins: Array<{
  validated_by: string | null;
  validated_at: string;
  ticket: { ticket_code: string | null; buyer_name: string | null };
}> = [];

try {
  rawSales = await queryRows(`
    SELECT s.amount, s.seller_name, s.created_at, s.payment_method, s.sales_point,
           t.ticket_code, t.buyer_name, t.buyer_phone, t.buyer_email
    FROM sales s
    LEFT JOIN tickets t ON s.ticket_id = t.id
    ORDER BY s.created_at DESC;
  `);

  tickets = await queryRows(`SELECT status FROM tickets;`);

  reservations = await queryRows(`
    SELECT ticket_code, buyer_name, buyer_phone
    FROM tickets
    WHERE status = 'reserved'
    ORDER BY ticket_code DESC
    LIMIT 8;
  `);

  const rawCheckins = await queryRows<{
    validated_by: string | null;
    validated_at: string;
    ticket_code: string | null;
    buyer_name: string | null;
  }>(`
    SELECT c.validated_by, c.validated_at, t.ticket_code, t.buyer_name
    FROM checkins c
    LEFT JOIN tickets t ON c.ticket_id = t.id
    ORDER BY c.validated_at DESC
    LIMIT 8;
  `);

  checkins = rawCheckins.map((row) => ({
    validated_by: row.validated_by,
    validated_at: row.validated_at,
    ticket: {
      ticket_code: row.ticket_code,
      buyer_name: row.buyer_name,
    },
  }));
} catch (err) {
  console.error("Error loading dashboard data:", err);
}

const sales = rawSales.map((sale) => ({
  amount: sale.amount,
  seller_name: sale.seller_name,
  created_at: sale.created_at,
  payment_method: sale.payment_method,
  sales_point: sale.sales_point,
  ticket: {
    ticket_code: sale.ticket_code,
    buyer_name: sale.buyer_name,
    buyer_phone: sale.buyer_phone,
    buyer_email: sale.buyer_email,
  },
}));

const salesByDayMap: Record<string, number> = {};
sales.forEach((sale) => {
  const dayStr = formatSiteDate(sale.created_at, { day: "numeric", month: "short" });
  salesByDayMap[dayStr] = (salesByDayMap[dayStr] || 0) + Number(sale.amount);
});
const salesByDay = Object.entries(salesByDayMap).slice(-7);
const maxDaySales = Math.max(...salesByDay.map(([, amt]) => amt), 1);

const salesBySellerMap: Record<string, number> = {};
sales.forEach((sale) => {
  const seller = sale.seller_name || "Desconocido";
  salesBySellerMap[seller] = (salesBySellerMap[seller] || 0) + Number(sale.amount);
});
const salesBySeller = Object.entries(salesBySellerMap)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);
const maxSellerSales = Math.max(...salesBySeller.map(([, amt]) => amt), 1);

const salesByPointMap: Record<string, number> = {};
sales.forEach((sale) => {
  const point = sale.sales_point || "Sin punto";
  salesByPointMap[point] = (salesByPointMap[point] || 0) + Number(sale.amount);
});
const salesByPoint = Object.entries(salesByPointMap)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);
const maxPointSales = Math.max(...salesByPoint.map(([, amt]) => amt), 1);

const totalRevenue = resolveGrossRevenue({
  salesAmounts: sales.map((sale) => sale.amount),
  ticketsSold: countTicketsSold(tickets),
  ticketPrice: getPinkFloydEventFallback().ticket_price,
});

const kpis = [
  { label: "Capacidad", value: formatSiteNumber(CAPACITY), tone: "slate" as const },
  { label: "Disponibles", value: formatSiteNumber(countTicketsByStatus(tickets, "available")), tone: "slate" as const },
  { label: "Asignados", value: formatSiteNumber(countTicketsByStatus(tickets, "assigned")), tone: "blue" as const },
  { label: "Reservados", value: formatSiteNumber(countTicketsByStatus(tickets, "reserved")), tone: "amber" as const },
  { label: "Vendidos", value: formatSiteNumber(countTicketsSold(tickets)), tone: "green" as const },
  { label: "Validados", value: formatSiteNumber(countTicketsByStatus(tickets, "validated")), tone: "purple" as const },
  { label: "Anulados", value: formatSiteNumber(countTicketsByStatus(tickets, "cancelled")), tone: "red" as const },
];

const pendingReservations = countTicketsByStatus(tickets, "reserved");
---

<AdminLayout title="Panel administrativo | FARECOH" description="Panel de administración de boletería de FARECOH" active="dashboard">
  <AdminPageHeader
    client:load
    title="Panel de control"
    section="Dashboard"
    description="Resumen operativo del evento Pink Floyd."
    currentDate={currentDate}
    staffProfile={staffProfile}
    authConfigured={authConfigured}
  />

  <AdminPage>
    <a
      href="/admin/reservations"
      class="group relative block overflow-hidden rounded-xl border border-amber-200/80 bg-gradient-to-r from-amber-50/80 via-amber-50/40 to-background p-5 transition-all hover:border-amber-300 hover:shadow-sm dark:border-amber-900/50 dark:from-amber-950/20 dark:to-card"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-3.5">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <p class="text-xs font-semibold uppercase tracking-wider text-amber-800 dark:text-amber-400">Reservas pendientes</p>
              <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">
                {formatSiteNumber(pendingReservations)}
              </span>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
              Requieren confirmación de pago, asignación o contacto directo con compradores.
            </p>
          </div>
        </div>
        <div class="inline-flex items-center gap-1.5 self-start rounded-lg border border-amber-300/80 bg-white px-3.5 py-1.5 text-xs font-semibold text-amber-900 shadow-xs transition-colors group-hover:bg-amber-50 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200 dark:group-hover:bg-amber-900/30 sm:self-center">
          <span>Gestionar reservas</span>
          <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    </a>

    <DashboardStats client:load kpis={kpis} revenue={formatSiteCurrency(totalRevenue)} />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
      <ProgressChartCard
        client:load
        title="Ventas por día"
        description="Tendencia de recaudación diaria"
        items={salesByDay.map(([day, amount]) => ({
          label: day,
          value: formatSiteCurrency(amount),
          pct: (amount / maxDaySales) * 100,
        }))}
        valueClassName="text-primary"
        barClassName="bg-primary"
      />
      <ProgressChartCard
        client:load
        title="Ventas por vendedor"
        description="Top vendedores de boletería física"
        items={salesBySeller.map(([seller, amount]) => ({
          label: seller,
          value: formatSiteCurrency(amount),
          pct: (amount / maxSellerSales) * 100,
        }))}
        barClassName="bg-blue-500"
      />
      <ProgressChartCard
        client:load
        title="Ventas por punto"
        description="Recaudación por punto de venta"
        items={salesByPoint.map(([point, amount]) => ({
          label: point,
          value: formatSiteCurrency(amount),
          pct: (amount / maxPointSales) * 100,
        }))}
        barClassName="bg-blue-400"
      />
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <RecentReservationsTable client:load reservations={reservations ?? []} />
      <RecentCheckinsTable client:load checkins={checkins ?? []} />
    </div>

    <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-3">
      <section class="lg:col-span-1">
        <TicketSearchQuick client:load />
      </section>
      <section class="lg:col-span-2">
        <SalesHistoryTable client:load sales={sales ?? []} />
      </section>
    </div>
  </AdminPage>
</AdminLayout>
