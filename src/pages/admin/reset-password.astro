---
import AdminAuthLayout from "@/layouts/AdminAuthLayout.astro";
---

<AdminAuthLayout title="Restablecer Contraseña | FARECOH">
  <main class="flex min-h-screen items-center justify-center px-margin py-12">
    <section class="w-full max-w-md rounded-lg border border-outline-variant bg-surface-container-lowest p-6 shadow-sm">
      <p class="label-caps text-primary">Seguridad de cuenta</p>
      <h1 class="mt-2 headline-md text-on-surface">Gestión de contraseñas</h1>
      <p class="mt-2 body-md text-on-surface-variant">
        Para restablecer o actualizar su contraseña, solicite asistencia al Super Administrador en el panel de usuarios, o inicie sesión si ya tiene acceso.
      </p>

      <div class="mt-6 text-center">
        <a href="/admin/login" class="inline-block rounded bg-primary px-4 py-3 label-caps text-on-primary transition-colors hover:bg-secondary">
          Volver a iniciar sesión
        </a>
      </div>
    </section>
  </main>
</AdminAuthLayout>
