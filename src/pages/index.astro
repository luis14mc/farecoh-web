---
import Layout from "@/layouts/Layout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import WhoWeAre from "@/components/landing/WhoWeAre.astro";
import CauseBlock from "@/components/landing/CauseBlock.astro";
import MissionVision from "@/components/landing/MissionVision.astro";
import WhatWeDo from "@/components/landing/WhatWeDo.astro";
import ImpactBlock from "@/components/landing/ImpactBlock.astro";
import EmotionalQuote from "@/components/landing/EmotionalQuote.astro";
import FinalCTA from "@/components/landing/FinalCTA.astro";
import { seoPages, organizationJsonLd, webSiteJsonLd } from "@/data/seo";
import Analytics from '@vercel/analytics/astro';
---

<Layout
  title={seoPages.home.title}
  description={seoPages.home.description}
  image={seoPages.home.image}
  canonicalPath={seoPages.home.path}
  jsonLd={[organizationJsonLd(), webSiteJsonLd()]}
  active="home"
>
  <LandingHero />
  <WhoWeAre />
  <CauseBlock />
  <MissionVision />
  <WhatWeDo />

  <section class="reveal-section bg-surface-container-lowest py-20 md:py-28" aria-labelledby="benefit-concert-title">
    <div class="landing-shell">
      <div class="grid overflow-hidden border border-outline-variant bg-surface shadow-xl lg:grid-cols-[0.95fr_1.05fr]">
        <figure class="relative min-h-[340px] lg:min-h-[520px]">
          <img
            src="/images/evento/hero.webp"
            alt="Escenario preparado para un concierto cultural benéfico"
            class="h-full min-h-[340px] w-full object-cover lg:min-h-[520px]"
            loading="lazy"
            width="1600"
            height="1067"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent" aria-hidden="true"></div>
          <figcaption class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <p class="max-w-sm text-sm font-medium leading-6 text-white/85">
              Una iniciativa cultural y solidaria impulsada desde el arte para acompañar una causa humana.
            </p>
          </figcaption>
        </figure>

        <div class="flex flex-col justify-center p-8 md:p-12 lg:p-16">
          <div class="mb-8 flex flex-wrap items-center gap-3">
            <span class="inline-flex border border-primary/20 bg-primary/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-primary">
              Próximamente
            </span>
            <span class="text-sm font-medium text-on-surface-variant">Valle de Ángeles, Honduras</span>
          </div>

          <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-on-surface-variant">
            Concierto benéfico
          </p>

          <h2 id="benefit-concert-title" class="max-w-3xl text-4xl font-extrabold leading-tight tracking-[-0.04em] text-on-surface md:text-5xl lg:text-6xl">
            Tributo a Pink Floyd a beneficio de José Joaquín Cerrato
          </h2>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-on-surface-variant">
            FARECOH prepara una noche musical en Valle de Ángeles para apoyar la recaudación de fondos destinada al trasplante de hígado de José Joaquín Cerrato.
          </p>

          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            <div class="border-l-2 border-primary bg-surface-container-lowest p-5">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-on-surface-variant">Formato</p>
              <p class="mt-2 text-base font-bold text-on-surface">Concierto tributo</p>
            </div>
            <div class="border-l-2 border-primary bg-surface-container-lowest p-5">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-on-surface-variant">Lugar</p>
              <p class="mt-2 text-base font-bold text-on-surface">Valle de Ángeles</p>
            </div>
            <div class="border-l-2 border-primary bg-surface-container-lowest p-5">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-on-surface-variant">Causa</p>
              <p class="mt-2 text-base font-bold text-on-surface">Trasplante de hígado</p>
            </div>
          </div>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href="/contacto"
              class="inline-flex min-h-11 items-center justify-center bg-primary px-6 py-3 text-sm font-bold uppercase tracking-[0.16em] text-on-primary transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
            >
              Quiero apoyar
            </a>
            <a
              href="/donar"
              class="inline-flex min-h-11 items-center justify-center border border-outline-variant px-6 py-3 text-sm font-bold uppercase tracking-[0.16em] text-on-surface transition hover:border-primary hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
            >
              Donar a la causa
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ImpactBlock />
  <EmotionalQuote />
  <FinalCTA />
</Layout>

<script>
  import { initParallax } from "@/scripts/parallax";

  initParallax();
</script>

<script is:inline>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    document.querySelectorAll(".reveal-section").forEach((section, index) => {
      section.style.setProperty("--reveal-delay", `${Math.min(index * 80, 320)}ms`);
      observer.observe(section);
    });
  } else {
    document.querySelectorAll(".reveal-section").forEach((section) => {
      section.classList.add("is-visible");
    });
  }
</script>
