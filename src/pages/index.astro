---
import Layout from "@/layouts/Layout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import WhoWeAre from "@/components/landing/WhoWeAre.astro";
import CauseBlock from "@/components/landing/CauseBlock.astro";
import MissionVision from "@/components/landing/MissionVision.astro";
import WhatWeDo from "@/components/landing/WhatWeDo.astro";
import ImpactBlock from "@/components/landing/ImpactBlock.astro";
import EmotionalQuote from "@/components/landing/EmotionalQuote.astro";
import FinalCTA from "@/components/landing/FinalCTA.astro";
import { seoPages, organizationJsonLd, webSiteJsonLd } from "@/data/seo";
import { site } from "@/data/site";
import Analytics from '@vercel/analytics/astro';

const benefitConcertSubject = encodeURIComponent("Apoyo concierto benéfico FARECOH");
const benefitConcertBody = encodeURIComponent(
  "Hola FARECOH, me gustaría recibir información para apoyar el concierto benéfico a beneficio de José Joaquín Cerrato.",
);
const benefitConcertMailto = `mailto:${site.email}?subject=${benefitConcertSubject}&body=${benefitConcertBody}`;
---

<Layout
  title={seoPages.home.title}
  description={seoPages.home.description}
  image={seoPages.home.image}
  canonicalPath={seoPages.home.path}
  jsonLd={[organizationJsonLd(), webSiteJsonLd()]}
  active="home"
>
  <LandingHero />
  <WhoWeAre />
  <CauseBlock />
  <MissionVision />
  <WhatWeDo />

  <section id="concierto-benefico" class="reveal-section bg-surface-container-lowest py-20 md:py-28" aria-labelledby="benefit-concert-title">
    <div class="landing-shell">
      <div class="grid overflow-hidden rounded-3xl border border-outline-variant/70 bg-surface shadow-xl lg:grid-cols-[0.95fr_1.05fr]">
        <figure class="relative min-h-[340px] lg:min-h-[520px]">
          <img
            src="/images/evento/hero.webp"
            alt="Escenario preparado para un concierto cultural benéfico"
            class="h-full min-h-[340px] w-full object-cover lg:min-h-[520px]"
            loading="lazy"
            width="1600"
            height="1067"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent" aria-hidden="true"></div>
          <figcaption class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <span class="inline-flex items-center gap-2 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white/90 backdrop-blur-md mb-2">
              <span class="h-1.5 w-1.5 rounded-full bg-concert-orange animate-ping"></span>
              Causa Solidaria
            </span>
            <p class="max-w-md text-sm font-medium leading-relaxed text-white/95">
              Una iniciativa cultural y solidaria impulsada desde el arte para acompañar una causa humana.
            </p>
          </figcaption>
        </figure>

        <div class="flex flex-col justify-center p-8 md:p-12 lg:p-16">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1 text-xs font-bold uppercase tracking-[0.18em] text-primary">
              Próximamente
            </span>
            <span class="text-xs font-semibold text-on-surface-variant/90">Valle de Ángeles, Honduras</span>
          </div>

          <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-primary">
            Concierto benéfico
          </p>

          <h2 id="benefit-concert-title" class="max-w-3xl text-3xl font-extrabold leading-tight tracking-tight text-on-surface sm:text-4xl lg:text-5xl">
            Tributo a Pink Floyd a beneficio de José Joaquín Cerrato
          </h2>

          <p class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-on-surface-variant">
            FARECOH prepara una noche musical en Valle de Ángeles para apoyar la recaudación de fondos destinada al trasplante de hígado de José Joaquín Cerrato.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-outline-variant/60 bg-surface-container-low/70 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-on-surface-variant/80">Formato</p>
              <p class="mt-1 text-sm font-bold text-on-surface">Concierto tributo</p>
            </div>
            <div class="rounded-xl border border-outline-variant/60 bg-surface-container-low/70 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-on-surface-variant/80">Lugar</p>
              <p class="mt-1 text-sm font-bold text-on-surface">Valle de Ángeles</p>
            </div>
            <div class="rounded-xl border border-outline-variant/60 bg-surface-container-low/70 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-on-surface-variant/80">Causa</p>
              <p class="mt-1 text-sm font-bold text-on-surface">Trasplante de hígado</p>
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={benefitConcertMailto}
              class="inline-flex min-h-[48px] items-center justify-center rounded-xl bg-primary px-7 py-3 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-md transition-all duration-200 hover:bg-brand-500 hover:shadow-lg hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 active:scale-98"
            >
              Quiero apoyar
            </a>
            <a
              href={`mailto:${site.email}`}
              class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-outline-variant px-7 py-3 text-xs font-bold uppercase tracking-[0.14em] text-on-surface transition-all duration-200 hover:border-primary hover:text-primary hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 active:scale-98"
            >
              Escribir a FARECOH
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ImpactBlock />
  <EmotionalQuote />
  <FinalCTA />
</Layout>

<script>
  import { initParallax } from "@/scripts/parallax";

  initParallax();
</script>

<script is:inline>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    document.querySelectorAll(".reveal-section").forEach((section, index) => {
      section.style.setProperty("--reveal-delay", `${Math.min(index * 80, 320)}ms`);
      observer.observe(section);
    });
  } else {
    document.querySelectorAll(".reveal-section").forEach((section) => {
      section.classList.add("is-visible");
    });
  }
</script>
