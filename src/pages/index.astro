---
import InstitutionalLayout from "@/layouts/InstitutionalLayout.astro";
import Orchestra3DCanvas from "@/components/canvas/Orchestra3DCanvas.astro";
import StitchPillars from "@/components/institutional/StitchPillars.astro";
import StitchPrograms from "@/components/institutional/StitchPrograms.astro";
import StitchAbout from "@/components/institutional/StitchAbout.astro";
import StitchImpact from "@/components/institutional/StitchImpact.astro";
import StitchEvents from "@/components/institutional/StitchEvents.astro";
import StitchCta from "@/components/institutional/StitchCta.astro";

import {
  FARECOH_CONTEXT,
  FARECOH_METADATA,
  FARECOH_NARRATIVE,
  FARECOH_PROGRAMS,
  FARECOH_WHY_SUPPORT,
  INSTITUTIONAL_STATS,
} from "@/data/farecoh";

const title = `${FARECOH_METADATA.acronym} · ${FARECOH_METADATA.fullName}`;
const description = FARECOH_METADATA.tagline;

const foundationYear = FARECOH_METADATA.established;
const yearsOfService = new Date().getFullYear() - foundationYear;

const stats = [
  {
    value: "+" + yearsOfService,
    label: "Años de trayectoria",
    caption: `Desde ${foundationYear}, formando generaciones con arte y música en Honduras.`,
  },
  ...INSTITUTIONAL_STATS,
];
---

<InstitutionalLayout
  title={title}
  description={description}
  canonicalPath="/"
  active="home"
  transparentHeader={true}
>
  <!-- ───────────────────────────────────────────────────────────────
       HERO — Lienzo 3D + composición asimétrica editorial
  ──────────────────────────────────────────────────────────────── -->
  <section
    class="hero-inst"
    aria-labelledby="hero-title"
    data-inst-hero
  >
    <div class="hero-inst__canvas" aria-hidden="true">
      <Orchestra3DCanvas />
    </div>

    <div class="hero-inst__grain" aria-hidden="true"></div>

    <div class="inst-shell hero-inst__shell">
      <div class="hero-inst__grid">
        <h1 id="hero-title" class="hero-inst__title">
          Transformando vidas a través del{" "}
          <span class="hero-inst__title-accent">arte, la educación y la esperanza.</span>
        </h1>

        <div class="hero-inst__actions">
          <a href="/sobre-nosotros" class="inst-cta inst-cta--solid">
            Conoce la fundación
            <span class="inst-cta__arrow" aria-hidden="true"></span>
          </a>
          <a
            href="/programas"
            class="inst-cta"
            style="color:#fff;border-color:rgba(255,255,255,0.5);"
          >
            Ver programas
            <span class="inst-cta__arrow" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero-inst__scrollbar" aria-hidden="true">
      <span>↓</span>
      <small>Desplazar</small>
    </div>
  </section>

  <!-- ───────────────────────────────────────────────────────────────
       PILARES — Barra de cuatro valores institucionales
  ──────────────────────────────────────────────────────────────── -->
  <StitchPillars />

  <!-- ───────────────────────────────────────────────────────────────
       PROGRAMAS — Cuatro tarjetas fotográficas
  ──────────────────────────────────────────────────────────────── -->
  <StitchPrograms
    eyebrow="Lo que hacemos"
    headline="Programas que combinan educación, arte y desarrollo comunitario"
    source="Desarrollamos programas innovadores para que cada niño y joven descubra su potencial y fortalezca sus valores."
    ctaLabel="Conoce todos los programas"
    programs={FARECOH_PROGRAMS}
  />

  <!-- ───────────────────────────────────────────────────────────────
       QUIÉNES SOMOS — Relato institucional + placa fotográfica
  ──────────────────────────────────────────────────────────────── -->
  <StitchAbout
    eyebrow="Quiénes Somos"
    headline="Creemos que el arte puede cambiar la realidad de Honduras"
    paragraphs={[
      FARECOH_CONTEXT.problem,
      FARECOH_NARRATIVE.about,
    ]}
    values={[
      { title: "Formación integral", body: "Valores, disciplina y talento a través del arte.", icon: "school" },
      { title: "Oportunidades", body: "Becas e instrumentos para jóvenes de escasos recursos.", icon: "infinity" },
      { title: "Comunidad", body: "Integración familiar y participación ciudadana.", icon: "handshake" },
    ]}
    image="/images/farecoh-hero-orchestra.webp"
    imageAlt="Orquesta juvenil de FARECOH en ensayo con su director"
    quote={FARECOH_NARRATIVE.vision}
    quoteAttribution="Visión institucional · FARECOH"
    ctaHref="/sobre-nosotros"
  />

  <!-- ───────────────────────────────────────────────────────────────
       IMPACTO — Cifras y testimonio institucional
  ──────────────────────────────────────────────────────────────── -->
  <StitchImpact
    eyebrow="Nuestro Impacto"
    headline="Cada clase y cada concierto son una oportunidad de transformación"
    source="Cada instrumento entregado, cada clase impartida y cada presentación artística representa una oportunidad de transformación."
    stats={stats}
    quote={FARECOH_CONTEXT.quote}
    attribution="FARECOH"
  />

  <!-- ───────────────────────────────────────────────────────────────
       CARTELERA — Próximo concierto benéfico
  ──────────────────────────────────────────────────────────────── -->
  <StitchEvents
    eyebrow="Nuestros conciertos"
    headline="Un concierto puede durar unas horas. Su impacto, toda una vida."
    source="Cada boleto, patrocinio y aporte financia becas, instrumentos y programas para la niñez y juventud hondureña."
  />

  <!-- ───────────────────────────────────────────────────────────────
       CTA — Únete a nuestra misión
  ──────────────────────────────────────────────────────────────── -->
  <StitchCta
    headline="Únase a nuestra misión"
    body={FARECOH_WHY_SUPPORT.join}
    donateHref="/sobre-nosotros#apoyar"
    volunteerHref="mailto:info@farecoh.org?subject=Quiero%20ser%20voluntario%20de%20FARECOH"
  />
</InstitutionalLayout>

<style>
  .hero-inst {
    position: relative;
    min-height: clamp(560px, 90svh, 1100px);
    background:
      radial-gradient(ellipse 80% 60% at 80% 30%, rgba(79, 195, 245, 0.18) 0%, transparent 60%),
      linear-gradient(180deg, #061a33 0%, #0b2545 55%, #0a1f3a 100%);
    color: var(--color-inst-ivory);
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-block: clamp(7rem, 14vh, 9rem) clamp(4rem, 8vh, 6rem);
  }

  .hero-inst__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-inst__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.06;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .hero-inst__shell {
    position: relative;
    z-index: 2;
  }

  .hero-inst__grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
    max-width: 60rem;
  }

  .hero-inst__title {
    margin: 0;
    font-family: var(--font-inst-display);
    font-weight: 700;
    font-variation-settings: "wdth" 105, "wght" 700, "opsz" 72;
    font-size: clamp(1.85rem, 5.5vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--color-inst-ivory);
    text-wrap: balance;
    max-width: 18ch;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .hero-inst__title {
      max-width: 24ch;
    }
  }

  .hero-inst__title-accent {
    color: var(--color-inst-cyan);
    font-style: italic;
    font-weight: 800;
  }

  .hero-inst__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .hero-inst__actions .inst-cta {
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero-inst__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }

    .hero-inst__actions .inst-cta {
      width: auto;
    }
  }

  @media (max-width: 1023px) {
    .hero-inst__title {
      max-width: 100%;
    }
  }

  .hero-inst__panel {
    display: none;
  }

  .hero-inst__scrollbar {
    position: absolute;
    bottom: 1.5rem;
    right: var(--spacing-inst-gutter);
    z-index: 3;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(250, 246, 238, 0.55);
    font-family: var(--font-inst-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .hero-inst__scrollbar {
      display: flex;
    }
  }

  .hero-inst__scrollbar span {
    display: block;
    font-size: 1rem;
    animation: inst-scroll 2.2s ease-in-out infinite;
  }

  @keyframes inst-scroll {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inst__scrollbar span {
      animation: none;
    }
  }
</style>

<script>
  import { animate, inView } from "@motionone/dom";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Marquee pacing (pause on hover for focus) ─────────────────────
  document.querySelectorAll<HTMLElement>("[data-marquee]").forEach((track) => {
    if (prefersReducedMotion) return;
    const pace = Number(track.dataset["marqueePace"] ?? "40");
    const halfWidth = track.scrollWidth / 2;
    if (!halfWidth) return;

    const animation = animate(
      track,
      { transform: ["translateX(0)", `translateX(-${halfWidth}px)`] },
      { duration: pace, easing: "linear", direction: "normal", repeat: Infinity },
    );

    track.addEventListener("mouseenter", () => animation.pause());
    track.addEventListener("mouseleave", () => animation.play());
    track.addEventListener("focusin", () => animation.pause());
    track.addEventListener("focusout", () => animation.play());
  });

  // ── Reveal on scroll (stagger 300-450ms per skill guidelines) ─────
  document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((node) => {
    if (prefersReducedMotion) {
      node.style.opacity = "1";
      node.style.transform = "none";
      return;
    }
    node.style.opacity = "0";
    node.style.transform = "translateY(20px)";
    node.style.willChange = "transform, opacity";
  });

  document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((node) => {
    const delay = Number(node.dataset["revealDelay"] ?? "0");
    inView(
      node,
      () => {
        if (prefersReducedMotion) {
          node.style.opacity = "1";
          node.style.transform = "none";
          return;
        }
        animate(
          node,
          { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
          { duration: 0.4, delay: delay / 1000, easing: [0.22, 1, 0.36, 1] },
        );
        return () => {
          node.style.opacity = "0";
          node.style.transform = "translateY(20px)";
        };
      },
      { amount: 0.15 },
    );
  });

  // ── Animated counters (rAF tween) ─────────────────────────────────
  const easeOutQuart = (t: number): number => 1 - Math.pow(1 - t, 4);

  document.querySelectorAll<HTMLElement>("[data-counter]").forEach((node) => {
    const target = Number(node.dataset["counterTarget"] ?? "0");
    const suffix = node.dataset["counterSuffix"] ?? "";
    if (!Number.isFinite(target)) {
      node.textContent = `${target}${suffix}`;
      return;
    }

    inView(
      node,
      () => {
        if (prefersReducedMotion) {
          node.textContent = `${target}${suffix}`;
          return;
        }
        const duration = 1400;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const value = easeOutQuart(progress) * target;
          node.textContent = `${Math.round(value)}${suffix}`;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        return () => {
          node.textContent = `0${suffix}`;
        };
      },
      { amount: 0.4 },
    );
  });
</script>
