---
import "@/styles/institutional.css";
import InstitutionalNavbar from "@/components/institutional/InstitutionalNavbar.astro";
import InstitutionalFooter from "@/components/institutional/InstitutionalFooter.astro";
import SeoHead from "@/components/seo/SeoHead.astro";
import { SITE_LANG } from "@/lib/locale";
import { FARECOH_METADATA } from "@/data/farecoh";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly canonicalPath?: string;
  readonly image?: string;
  readonly ogType?: string;
  readonly noindex?: boolean;
  readonly jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  readonly active?:
    | "home"
    | "about"
    | "programs"
    | "mobility"
    | "board"
    | "partners";
  readonly transparentHeader?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  image,
  ogType,
  noindex,
  jsonLd,
  active,
  transparentHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE_LANG} class="inst-root-html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta name="theme-color" content="#0b2545" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content={`${FARECOH_METADATA.fullName} — ${FARECOH_METADATA.tagline}`}
    />

    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <title>{title}</title>
  </head>
  <body class="inst-root">
    <a class="inst-skip" href="#main-content">Saltar al contenido principal</a>
    <InstitutionalNavbar active={active} transparent={transparentHeader} />
    <main id="main-content">
      <slot />
    </main>
    <InstitutionalFooter />

    <script>
      const header = document.querySelector(".inst-nav");
      if (header instanceof HTMLElement) {
        const handleScroll = () => {
          header.classList.toggle("inst-nav--condensed", window.scrollY > 32);
        };
        handleScroll();
        window.addEventListener("scroll", handleScroll, { passive: true });
      }

      const menuBtn = document.querySelector("[data-inst-menu-open]");
      const closeBtn = document.querySelector("[data-inst-menu-close]");
      const panel = document.querySelector("[data-inst-mobile-panel]");
      const backdrop = document.querySelector("[data-inst-mobile-backdrop]");
      if (
        menuBtn instanceof HTMLButtonElement &&
        panel instanceof HTMLElement
      ) {
        const open = () => {
          panel.dataset["open"] = "true";
          if (backdrop instanceof HTMLElement) backdrop.dataset["open"] = "true";
          menuBtn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
          const focusable = panel.querySelector<HTMLElement>(
            "a, button:not([disabled])",
          );
          focusable?.focus();
        };
        const close = () => {
          panel.dataset["open"] = "false";
          if (backdrop instanceof HTMLElement) backdrop.dataset["open"] = "false";
          menuBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          menuBtn.focus();
        };
        menuBtn.addEventListener("click", open);
        if (closeBtn instanceof HTMLButtonElement) {
          closeBtn.addEventListener("click", close);
        }
        if (backdrop instanceof HTMLElement) {
          backdrop.addEventListener("click", close);
        }
        panel.addEventListener("click", (event) => {
          if (event.target instanceof HTMLAnchorElement || (event.target instanceof HTMLElement && event.target.closest("a"))) {
            close();
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && panel.dataset["open"] === "true") {
            close();
          }
        });
      }
    </script>
  </body>
</html>
