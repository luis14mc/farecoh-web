---
import "../styles/global.css";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import SeoHead from "@/components/seo/SeoHead.astro";
import { SITE_LANG } from "@/lib/locale";

interface Props {
  title: string;
  description: string;
  active?: "home" | "about" | "programs" | "events" | "tickets";
  variant?: "light" | "dark" | "concert";
  canonicalPath?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  active,
  variant = "light",
  canonicalPath,
  image,
  ogType,
  noindex,
  jsonLd,
} = Astro.props;

const bodyClass =
  variant === "concert"
    ? "universe-concert min-h-screen selection:bg-concert-orange selection:text-white"
    : variant === "dark"
      ? "min-h-screen bg-brand-neutral text-surface-bright selection:bg-primary-container selection:text-on-primary-container"
      : "min-h-screen bg-surface text-on-surface selection:bg-primary-container selection:text-on-primary-container";

const mainClass = variant === "light" ? "pt-20" : "";
---

<!doctype html>
<html class={variant} lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0&display=swap" rel="stylesheet" />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[120] focus:rounded-md focus:bg-primary focus:px-5 focus:py-2.5 focus:text-sm focus:font-bold focus:text-white focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-brand-400 focus:ring-offset-2"
      href="#main-content"
    >
      Saltar al contenido
    </a>
    <Navbar active={active} variant={variant} />
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <Footer variant={variant} />
  </body>
</html>

<style is:global>
  .reveal-section {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1)), transform 0.4s var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
    will-change: opacity, transform;
  }

  .reveal-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-section {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
