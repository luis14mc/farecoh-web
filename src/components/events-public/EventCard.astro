---
import type { ManagedEvent } from "@/services/events";
import { eventDateLabel, salesAreOpen } from "@/services/public-events";
import { formatSiteCurrency } from "@/lib/locale";

interface Props {
  readonly event: ManagedEvent;
  readonly past?: boolean;
}

const { event, past = false } = Astro.props;
const href = `/eventos/${event.slug}`;
const image = event.image_url ?? (event.slug === "pink-floyd" ? "/images/evento/hero.webp" : "/images/farecoh-hero-orchestra.webp");
const day = event.event_date.slice(8);
const month = new Intl.DateTimeFormat("es-HN", { month: "short", timeZone: "UTC" })
  .format(new Date(event.event_date)).replace(".", "").toUpperCase();
const open = !past && salesAreOpen(event);
---

<article class:list={["ev-card", { "ev-card--past": past }]}>
  <a href={href} class="ev-card__media" tabindex="-1" aria-hidden="true">
    <img src={image} alt="" loading="lazy" decoding="async" />
    <span class="ev-card__date">
      <strong>{day}</strong>
      <small>{month}</small>
    </span>
    {open && <span class="ev-card__badge">Boletería abierta</span>}
    {past && <span class="ev-card__badge ev-card__badge--muted">Finalizado</span>}
  </a>
  <div class="ev-card__body">
    <h3 class="ev-card__title"><a href={href}>{event.title}</a></h3>
    {(event.subtitle ?? event.description) && <p class="ev-card__desc">{event.subtitle ?? event.description}</p>}
    <ul class="ev-card__meta">
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4M16 3v4M3 11h18" /></svg>
        {eventDateLabel(event.event_date)} · {event.event_time}
      </li>
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
        {event.location}{event.city && !event.location.includes(event.city) ? `, ${event.city}` : ""}
      </li>
    </ul>
    <div class="ev-card__foot">
      <span class="ev-card__price">{event.ticket_price > 0 ? formatSiteCurrency(event.ticket_price) : "Entrada libre"}</span>
      <a href={open ? `${href}/boletos` : href} class:list={["ev-card__cta", { "ev-card__cta--ghost": !open }]}>
        {open ? "Reservar" : "Ver detalles"}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .ev-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(8, 46, 82, 0.08);
    transition: box-shadow 240ms ease, transform 240ms ease;
    font-family: "Inter", system-ui, sans-serif;
  }
  .ev-card:hover { box-shadow: 0 18px 40px -18px rgba(8, 46, 82, 0.35); transform: translateY(-2px); }
  .ev-card__media { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #00507c; }
  .ev-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  .ev-card:hover .ev-card__media img { transform: scale(1.04); }
  .ev-card--past .ev-card__media img { filter: grayscale(0.6) brightness(0.9); }
  .ev-card__date {
    position: absolute; top: 0.85rem; left: 0.85rem;
    display: grid; justify-items: center; line-height: 1;
    padding: 0.45rem 0.7rem; border-radius: 10px;
    background: #005082; color: #fff; box-shadow: 0 6px 16px rgba(8, 46, 82, 0.3);
  }
  .ev-card__date strong { font-size: 1.25rem; font-weight: 800; }
  .ev-card__date small { margin-top: 0.2rem; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.1em; }
  .ev-card__badge {
    position: absolute; top: 0.85rem; right: 0.85rem;
    padding: 0.3rem 0.7rem; border-radius: 999px;
    background: #83cfff; color: #00324f; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.02em;
  }
  .ev-card__badge--muted { background: rgba(255, 255, 255, 0.9); color: #404750; }
  .ev-card__body { display: flex; flex: 1; flex-direction: column; gap: 0.75rem; padding: 1.4rem 1.5rem 1.5rem; }
  .ev-card__title { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; }
  .ev-card__title a { color: #005082; text-decoration: none; }
  .ev-card__title a:hover { color: #0069a8; }
  .ev-card__desc { margin: 0; color: #404750; font-size: 0.9375rem; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ev-card__meta { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; color: #5b6572; font-size: 0.875rem; }
  .ev-card__meta li { display: flex; gap: 0.45rem; align-items: flex-start; }
  .ev-card__meta svg { flex-shrink: 0; margin-top: 0.15rem; color: #0069a8; }
  .ev-card__foot { margin-top: auto; padding-top: 1rem; border-top: 1px solid #e4ecf2; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .ev-card__price { font-weight: 700; color: #005082; }
  .ev-card__cta {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.6rem 1.05rem; border-radius: 10px;
    background: #005082; color: #fff; font-size: 0.875rem; font-weight: 600; text-decoration: none;
    transition: background-color 180ms ease;
  }
  .ev-card__cta:hover { background: #0069a8; }
  .ev-card__cta--ghost { background: #eff4f8; color: #005082; }
  .ev-card__cta--ghost:hover { background: #dcebf5; }
  .ev-card a:focus-visible { outline: 2px solid #0069a8; outline-offset: 3px; border-radius: 6px; }
</style>
