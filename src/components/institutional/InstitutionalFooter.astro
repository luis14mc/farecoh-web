---
import { FARECOH_METADATA, FARECOH_CONTACT } from "@/data/farecoh";
import { site } from "@/data/site";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand-col">
        <a href="/" class="site-footer__brand" aria-label={`${FARECOH_METADATA.acronym} — Inicio`}>
          <img src="/images/Logos/logo_blanco.png" alt="" class="site-footer__logo" loading="lazy" decoding="async" />
        </a>
        <p class="site-footer__tagline">
          Transformando vidas mediante la música, el arte y la inclusión social en Honduras.
        </p>
        <div class="site-footer__social" aria-label="Redes sociales">
          <a href={`mailto:${FARECOH_CONTACT.email}`} aria-label="Correo electrónico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z" />
            </svg>
          </a>
          <a href="/programas" aria-label="Galería de programas">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="4" /><circle cx="9" cy="9" r="2" /><path d="m21 15-4.5-4.5L7 20" />
            </svg>
          </a>
          <a href="/eventos/pink-floyd" aria-label="Eventos">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 7 16 12l7 5V7Z" /><rect x="1" y="5" width="15" height="14" rx="3" />
            </svg>
          </a>
          <a href="/donaciones" aria-label="Donaciones">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
            </svg>
          </a>
        </div>
      </div>

      <nav class="site-footer__col" aria-label="Navegación">
        <h2 class="site-footer__title">Navegación</h2>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/sobre-nosotros">Nosotros</a></li>
          <li><a href="/#impacto">Impacto</a></li>
          <li><a href="/eventos/pink-floyd">Eventos</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Programas">
        <h2 class="site-footer__title">Programas</h2>
        <ul>
          <li><a href="/programas">Coros y Orquestas</a></li>
          <li><a href="/programas">Coro de Manos Blancas</a></li>
          <li><a href="/programas">Artes Plásticas y Visuales</a></li>
          <li><a href="/programas">Estimulación Musical Temprana</a></li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Contacto</h2>
        <ul class="site-footer__contact">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" />
            </svg>
            <span>{FARECOH_CONTACT.postalAddress}</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="3" /><path d="m22 7-10 7L2 7" />
            </svg>
            <a href={`mailto:${FARECOH_CONTACT.email}`}>{FARECOH_CONTACT.email}</a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
            </svg>
            <a href={`tel:${FARECOH_CONTACT.phone.replace(/\s/g, "")}`}>{FARECOH_CONTACT.phone}</a>
          </li>
        </ul>
        <a href="/donaciones" class="site-footer__donate">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21s-7.6-4.7-9.6-9A5.5 5.5 0 0 1 12 5.6 5.5 5.5 0 0 1 21.6 12c-2 4.3-9.6 9-9.6 9Z" />
          </svg>
          Hacer Donación Rápida
        </a>
      </div>
    </div>

    <div class="site-footer__legal">
      <span>© {currentYear} {FARECOH_METADATA.acronym} — {FARECOH_METADATA.fullName}. Todos los derechos reservados.</span>
      <span class="site-footer__legal-links">
        <a href="/sobre-nosotros">Políticas de Privacidad</a>
        <a href="/sobre-nosotros">Términos y Condiciones</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: #00507c;
    color: #ffffff;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    overflow: hidden;
  }

  .site-footer__inner {
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    padding-block: clamp(3rem, 5vw, 4rem) 1.5rem;
  }

  @media (min-width: 1024px) {
    .site-footer__inner {
      width: min(100% - 6rem, 1280px);
    }
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .site-footer__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1.15fr 1.25fr;
      gap: 3rem;
    }
  }

  .site-footer__logo {
    height: 3.25rem;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .site-footer__tagline {
    margin: 1rem 0 0;
    max-width: 20rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .site-footer__social a:hover {
    background: rgba(255, 255, 255, 0.28);
    transform: translateY(-2px);
  }

  .site-footer__title {
    margin: 0 0 1rem;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #ffffff;
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .site-footer__col a {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-footer__col a:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.5;
  }

  .site-footer__contact svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: #83cfff;
  }

  .site-footer__donate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    border-radius: 9999px;
    background: #ffffff;
    color: #005082;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .site-footer__donate:hover {
    background: #eff4f8;
    transform: translateY(-1px);
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (min-width: 768px) {
    .site-footer__legal {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .site-footer__legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .site-footer__legal a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
  }

  .site-footer__legal a:hover { color: #ffffff; }
</style>
