---
/**
 * ThemeToggle — Referencia de uso (las clases reales se inyectan vía
 * institutional.css y el handler de click se monta en InstitutionalLayout).
 *
 * Este componente documenta la API visual. Para usarlo en cualquier lugar,
 * replica el bloque de marcado a continuación — los estilos y el handler
 * son globales, así que basta con colocar el botón con `data-theme-toggle`.
 *
 * Marcado de referencia:
 *   <button class="theme-toggle" data-theme-toggle aria-label="Cambiar tema">
 *     <span class="theme-toggle__track">
 *       <span class="theme-toggle__thumb">
 *         <svg class="theme-toggle__icon theme-toggle__icon--sun" …>…</svg>
 *         <svg class="theme-toggle__icon theme-toggle__icon--moon" …>…</svg>
 *       </span>
 *     </span>
 *     <span class="theme-toggle__label">
 *       <span class="theme-toggle__label-light">Claro</span>
 *       <span class="theme-toggle__label-dark">Oscuro</span>
 *     </span>
 *   </button>
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Cambiar modo claro/oscuro"
  title="Cambiar tema"
  hidden
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__thumb">
      <svg class="theme-toggle__icon theme-toggle__icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </span>
  </span>
  <span class="theme-toggle__label">
    <span class="theme-toggle__label-light">Claro</span>
    <span class="theme-toggle__label-dark">Oscuro</span>
  </span>
</button>