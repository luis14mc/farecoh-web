---
import type { InstitutionalStat } from "@/data/farecoh";

interface Props {
  readonly eyebrow: string;
  readonly headline: string;
  readonly source: string;
  readonly stats: readonly InstitutionalStat[];
  readonly quote: string;
  readonly attribution: string;
}

const { eyebrow, headline, source, stats, quote, attribution } = Astro.props;
---

<section class="fc-impact" id="impacto" aria-labelledby="impact-title">
  <div class="fc-impact__inner">
    <header class="fc-impact__head">
      <p class="fc-impact__eyebrow">{eyebrow}</p>
      <h2 id="impact-title" class="fc-impact__title">{headline}</h2>
      <p class="fc-impact__sub">{source}</p>
    </header>

    <div class="fc-impact__grid">
      {
        stats.map((stat, index) => (
          <div class="fc-impact__card">
            <span class:list={["fc-impact__num", { "fc-impact__num--alt": index % 2 === 1 }]}>
              {stat.value}
            </span>
            <span class="fc-impact__label">{stat.label}</span>
            <p class="fc-impact__caption">{stat.caption}</p>
          </div>
        ))
      }
    </div>

    <figure class="fc-impact__testimonial">
      <span class="fc-impact__badge" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
          <path d="M9.6 6C6.5 6 4 8.6 4 11.8V18h6.2v-6.2H7.1c0-1.6 1.1-2.7 2.5-2.7V6Zm10.3 0c-3.1 0-5.6 2.6-5.6 5.8V18H20.5v-6.2h-3.1c0-1.6 1.1-2.7 2.5-2.7V6Z" />
        </svg>
      </span>
      <div class="fc-impact__testimonial-body">
        <div class="fc-impact__stars" aria-label="Valoración institucional">
          {Array.from({ length: 5 }).map(() => (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z" />
            </svg>
          ))}
        </div>
        <blockquote class="fc-impact__quote">{quote}</blockquote>
        <figcaption>
          <span class="fc-impact__name">{attribution}</span>
          <span class="fc-impact__role">Tegucigalpa, Honduras</span>
        </figcaption>
      </div>
    </figure>
  </div>
</section>

<style>
  .fc-impact {
    background: #eff4f8;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .fc-impact__inner {
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .fc-impact__inner { width: min(100% - 6rem, 1280px); }
  }

  .fc-impact__head {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .fc-impact__eyebrow {
    margin: 0;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0069a8;
  }

  .fc-impact__title {
    margin: 0;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #005082;
    text-wrap: balance;
  }

  .fc-impact__sub {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #404750;
  }

  .fc-impact__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .fc-impact__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .fc-impact__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1.5rem 1.25rem;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 1px 3px rgba(8, 46, 82, 0.06);
    transition: box-shadow 220ms ease, transform 220ms ease;
  }

  .fc-impact__card:hover {
    box-shadow: 0 10px 24px -10px rgba(8, 46, 82, 0.28);
    transform: translateY(-2px);
  }

  .fc-impact__num {
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #005082;
    font-variant-numeric: tabular-nums;
  }

  .fc-impact__num--alt { color: #0069a8; }

  .fc-impact__label {
    margin-top: 0.4rem;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #171c1f;
  }

  .fc-impact__caption {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: #5b6572;
  }

  .fc-impact__testimonial {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(8, 46, 82, 0.06);
  }

  @media (min-width: 768px) {
    .fc-impact__testimonial {
      flex-direction: row;
      align-items: center;
      gap: clamp(1.75rem, 3vw, 2.5rem);
    }
  }

  .fc-impact__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(6rem, 12vw, 8rem);
    height: clamp(6rem, 12vw, 8rem);
    border-radius: 9999px;
    background: #cfe5ff;
    color: #005082;
    flex-shrink: 0;
  }

  .fc-impact__testimonial-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .fc-impact__stars {
    display: flex;
    gap: 0.15rem;
    color: #0069a8;
  }

  .fc-impact__quote {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    font-style: italic;
    color: #171c1f;
    max-width: 56rem;
  }

  .fc-impact__quote::before { content: "«"; }
  .fc-impact__quote::after { content: "»"; }

  .fc-impact__testimonial figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .fc-impact__name {
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #005082;
  }

  .fc-impact__role {
    font-size: 0.8125rem;
    color: #5b6572;
  }
</style>
