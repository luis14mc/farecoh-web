---
interface Props {
  readonly headline?: string;
  readonly body?: string;
  readonly donateHref?: string;
  readonly volunteerHref?: string;
}

const {
  headline = "Únete a nuestra misión",
  body = "Tu apoyo permite que más niñas, niños y jóvenes descubran, desarrollen y vivan su talento con becas de formación artística.",
  donateHref = "/donaciones",
  volunteerHref = "/sobre-nosotros",
} = Astro.props;
---

<section class="fc-cta" aria-labelledby="cta-title">
  <svg class="fc-cta__wave" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,0 C300,70 600,10 900,65 C1050,90 1150,45 1200,30 L1200,0 L0,0 Z" fill="#f5fafe" />
  </svg>

  <div class="fc-cta__watermark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M20 3.5a1 1 0 0 0-1.2-.98l-9 2A1 1 0 0 0 9 5.5v9.1A4 4 0 1 0 11 18V8.28l7-1.56v5.88A4 4 0 1 0 20 16V3.5Z" />
    </svg>
  </div>

  <div class="fc-cta__inner">
    <div class="fc-cta__content">
      <span class="fc-cta__bar" aria-hidden="true"></span>
      <div class="fc-cta__copy">
        <h2 id="cta-title" class="fc-cta__title">{headline}</h2>
        <p class="fc-cta__text">{body}</p>
      </div>
    </div>

    <div class="fc-cta__actions">
      <a href={donateHref} class="fc-cta__btn fc-cta__btn--solid">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21s-7.6-4.7-9.6-9A5.5 5.5 0 0 1 12 5.6 5.5 5.5 0 0 1 21.6 12c-2 4.3-9.6 9-9.6 9Z" />
        </svg>
        <span>Apoya a FARECOH</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </a>
      <a href={volunteerHref} class="fc-cta__btn fc-cta__btn--outline">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m11 17 2 2a1 1 0 1 0 3-3" />
          <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.9-3.9a2 2 0 0 0-2.8 0L9 11" />
          <path d="m21 3-3 3m-3-3 3 3M3 3l3 3m3-3-3 3" />
          <path d="M8 10 5.5 12.5a1 1 0 1 0 3 3L11 13" />
        </svg>
        <span>Ser Voluntario</span>
      </a>
    </div>
  </div>
</section>

<style>
  .fc-cta {
    position: relative;
    overflow: hidden;
    background: #005082;
    color: #ffffff;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    padding-block: clamp(3.5rem, 6vw, 5rem) clamp(3rem, 5vw, 4rem);
    isolation: isolate;
  }

  .fc-cta__wave {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2.5rem;
    display: block;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .fc-cta__wave { height: 3rem; }
  }

  .fc-cta__watermark {
    position: absolute;
    right: -2rem;
    bottom: -3rem;
    width: 18rem;
    height: 18rem;
    color: #83cfff;
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }

  @media (min-width: 768px) {
    .fc-cta__watermark { width: 24rem; height: 24rem; right: -1rem; }
  }

  .fc-cta__watermark svg {
    width: 100%;
    height: 100%;
  }

  .fc-cta__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .fc-cta__inner {
      width: min(100% - 6rem, 1280px);
      flex-direction: row;
      align-items: center;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .fc-cta__content {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 46rem;
  }

  .fc-cta__bar {
    display: block;
    width: 0.375rem;
    height: 4rem;
    border-radius: 9999px;
    background: #83cfff;
    flex-shrink: 0;
  }

  .fc-cta__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .fc-cta__title {
    margin: 0;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.75rem, 3vw + 0.4rem, 2.5rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #ffffff;
  }

  .fc-cta__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .fc-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .fc-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    border-radius: 9999px;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .fc-cta__btn--solid {
    background: #ffffff;
    color: #005082;
    box-shadow: 0 8px 24px rgba(3, 32, 54, 0.22);
  }

  .fc-cta__btn--solid:hover {
    background: #eff4f8;
    transform: translateY(-1px);
  }

  .fc-cta__btn--outline {
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
  }

  .fc-cta__btn--outline:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }
</style>
