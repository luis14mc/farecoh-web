---
interface Photo {
  readonly src: string;
  readonly alt: string;
  readonly span?: "wide" | "tall" | "square";
}

interface Props {
  readonly photos: readonly Photo[];
  readonly caption?: string;
  readonly eyebrow?: string;
  readonly variant?: "scroll" | "grid";
}

const { photos, caption, eyebrow, variant = "scroll" } = Astro.props;
---

<section
  class={`photo-strip photo-strip--${variant}`}
  aria-label={caption ?? "Galería fotográfica"}
>
  <header class="photo-strip__head">
    {eyebrow && (
      <p class="tag photo-strip__eyebrow">
        <span class="bar" aria-hidden="true"></span>
        {eyebrow}
      </p>
    )}
    {caption && <h2 class="photo-strip__caption">{caption}</h2>}
  </header>

  <div class="photo-strip__track" role="list">
    {
      photos.map((photo) => (
        <figure
          class={`photo-strip__figure photo-strip__figure--${photo.span ?? "square"}`}
          role="listitem"
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .photo-strip {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--color-bg-canvas);
  }

  .photo-strip__head {
    width: min(100% - calc(var(--spacing-inst-gutter) * 2), var(--spacing-inst-shell));
    margin-inline: auto;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .photo-strip__eyebrow {
    color: var(--color-accent-ruby);
    margin: 0;
  }

  .photo-strip__caption {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw + 1rem, 3rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.022em;
    max-width: 22ch;
  }

  .photo-strip__track {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--spacing-inst-gutter), calc((100vw - var(--spacing-inst-shell)) / 2 + var(--spacing-inst-gutter)));
    padding-inline: max(var(--spacing-inst-gutter), calc((100vw - var(--spacing-inst-shell)) / 2 + var(--spacing-inst-gutter)));
    padding-block: 0.5rem 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-brand-cyan) transparent;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y;
  }

  .photo-strip__track::-webkit-scrollbar {
    height: 6px;
  }

  .photo-strip__track::-webkit-scrollbar-thumb {
    background: var(--color-brand-cyan);
    border-radius: var(--radius-pill);
  }

  .photo-strip__figure {
    flex: 0 0 auto;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-stage);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-editorial);
    scroll-snap-align: start;
  }

  .photo-strip--grid .photo-strip__figure {
    flex: 1 1 0;
  }

  .photo-strip__figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .photo-strip__figure:hover img {
    transform: scale(1.04);
  }

  .photo-strip__figure--square {
    width: clamp(200px, 68vw, 320px);
    aspect-ratio: 1 / 1;
  }

  .photo-strip__figure--wide {
    width: clamp(260px, 82vw, 460px);
    aspect-ratio: 16 / 10;
  }

  .photo-strip__figure--tall {
    width: clamp(190px, 60vw, 280px);
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 1024px) {
    .photo-strip__figure--square {
      width: clamp(220px, 28vw, 320px);
    }

    .photo-strip__figure--wide {
      width: clamp(300px, 38vw, 460px);
    }

    .photo-strip__figure--tall {
      width: clamp(220px, 24vw, 280px);
    }
  }
</style>