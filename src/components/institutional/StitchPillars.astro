---
const pillars = [
  {
    title: "Arte",
    subtitle: "música, coros, orquestas y artes",
    icon: "music",
  },
  {
    title: "Educación",
    subtitle: "formación integral de la niñez y juventud",
    icon: "people",
  },
  {
    title: "Cultura",
    subtitle: "identidad y cultura de paz",
    icon: "plant",
  },
  {
    title: "Transformación social",
    subtitle: "comunidades más seguras e inclusivas",
    icon: "heart",
  },
] as const;
---

<section class="fc-pillars" aria-label="Pilares de la fundación">
  <div class="fc-pillars__inner">
    {
      pillars.map((pillar) => (
        <div class="fc-pillars__item">
          <span class="fc-pillars__icon" aria-hidden="true">
            {pillar.icon === "music" && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 3.5a1 1 0 0 0-1.2-.98l-9 2A1 1 0 0 0 9 5.5v9.1A4 4 0 1 0 11 18V8.28l7-1.56v5.88A4 4 0 1 0 20 16V3.5Z" />
              </svg>
            )}
            {pillar.icon === "people" && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 19c0-3 2.7-5 6-5s6 2 6 5v1H2v-1Zm14.5-4c2.5.4 4.5 2.1 4.5 4v1h-6v-1c0-1.5-.6-2.9-1.6-4 .9-.1 1.9 0 3.1 0Z" />
              </svg>
            )}
            {pillar.icon === "plant" && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2c-.4 3.6-3 6-6.5 6.3C5.7 12 8.7 15 12 15s6.3-3 6.5-6.7C15 8 12.4 5.6 12 2Zm-1 14.6V22h2v-5.4c3.3-.5 6-2.7 7-5.7-1.7.7-3.4 1-5 1.1 2.3 1.7 3.9 4.4 4 7.5H5c.1-3.1 1.7-5.8 4-7.5-1.6-.1-3.3-.4-5-1.1 1 3 3.7 5.2 7 5.7Z" />
              </svg>
            )}
            {pillar.icon === "heart" && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21s-7.6-4.7-9.6-9A5.5 5.5 0 0 1 12 5.6 5.5 5.5 0 0 1 21.6 12c-2 4.3-9.6 9-9.6 9Z" />
              </svg>
            )}
          </span>
          <span class="fc-pillars__copy">
            <span class="fc-pillars__title">{pillar.title}</span>
            <span class="fc-pillars__subtitle">{pillar.subtitle}</span>
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .fc-pillars {
    background: #ffffff;
    border-bottom: 1px solid #e8eef4;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .fc-pillars__inner {
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    padding-block: 1.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 1.5rem;
  }

  @media (min-width: 640px) {
    .fc-pillars__inner { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .fc-pillars__inner {
      width: min(100% - 6rem, 1280px);
      grid-template-columns: repeat(4, 1fr);
      padding-block: 2rem;
    }
  }

  .fc-pillars__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .fc-pillars__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: #cfe5ff;
    color: #005082;
    flex-shrink: 0;
  }

  .fc-pillars__copy {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .fc-pillars__title {
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #005082;
  }

  .fc-pillars__subtitle {
    font-size: 0.875rem;
    color: #5b6572;
  }
</style>
