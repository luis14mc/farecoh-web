---
interface ValueItem {
  readonly title: string;
  readonly body: string;
  readonly icon: "school" | "infinity" | "handshake";
}

interface Props {
  readonly eyebrow: string;
  readonly headline: string;
  readonly paragraphs: readonly string[];
  readonly values: readonly ValueItem[];
  readonly image: string;
  readonly imageAlt: string;
  readonly quote: string;
  readonly quoteAttribution: string;
  readonly ctaHref?: string;
  readonly ctaLabel?: string;
}

const {
  eyebrow,
  headline,
  paragraphs,
  values,
  image,
  imageAlt,
  quote,
  quoteAttribution,
  ctaHref = "/sobre-nosotros",
  ctaLabel = "Leer más sobre nuestra historia y equipo",
} = Astro.props;
---

<section class="fc-about" aria-labelledby="about-title">
  <div class="fc-about__inner">
    <div class="fc-about__copy">
      <p class="fc-about__eyebrow">
        <span>{eyebrow}</span>
        <span class="fc-about__rule" aria-hidden="true"></span>
      </p>
      <h2 id="about-title" class="fc-about__title">{headline}</h2>

      {paragraphs.map((paragraph, index) => (
        <p class:list={["fc-about__text", { "fc-about__text--lead": index === 0 }]}>
          {paragraph}
        </p>
      ))}

      <div class="fc-about__values">
        {
          values.map((value) => (
            <div class="fc-about__value">
              <span class="fc-about__value-icon" aria-hidden="true">
                {value.icon === "school" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3 1 8l11 5 9-4.1V15h2V8L12 3Zm-7 9.5V17c0 2.2 3.1 4 7 4s7-1.8 7-4v-4.5l-7 3.2-7-3.2Z" />
                  </svg>
                )}
                {value.icon === "infinity" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M18.2 8.3a3.9 3.9 0 0 0-5.5 0L12 9l-.7-.7a3.9 3.9 0 0 0-5.5 5.5l.7.7a3.9 3.9 0 0 0 5.5 0l.7-.7.7.7a3.9 3.9 0 0 0 5.5-5.5l-.7-.7Z" />
                  </svg>
                )}
                {value.icon === "handshake" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m11 17 2 2a1 1 0 1 0 3-3" />
                    <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.9-3.9a2 2 0 0 0-2.8 0L9 11" />
                    <path d="m21 3-3 3m-3-3 3 3M3 3l3 3m3-3-3 3" />
                    <path d="M8 10 5.5 12.5a1 1 0 1 0 3 3L11 13" />
                  </svg>
                )}
              </span>
              <span class="fc-about__value-title">{value.title}</span>
              <span class="fc-about__value-body">{value.body}</span>
            </div>
          ))
        }
      </div>

      <a href={ctaHref} class="fc-about__cta">
        <span>{ctaLabel}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="fc-about__media">
      <div class="fc-about__frame">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
      <figure class="fc-about__quote">
        <span class="fc-about__quote-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9.6 6C6.5 6 4 8.6 4 11.8V18h6.2v-6.2H7.1c0-1.6 1.1-2.7 2.5-2.7V6Zm10.3 0c-3.1 0-5.6 2.6-5.6 5.8V18H20.5v-6.2h-3.1c0-1.6 1.1-2.7 2.5-2.7V6Z" />
          </svg>
        </span>
        <span class="fc-about__quote-body">
          <blockquote>{quote}</blockquote>
          <figcaption>{quoteAttribution}</figcaption>
        </span>
      </figure>
    </div>
  </div>
</section>

<style>
  .fc-about {
    background: #ffffff;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .fc-about__inner {
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .fc-about__inner {
      width: min(100% - 6rem, 1280px);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .fc-about__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .fc-about__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0069a8;
  }

  .fc-about__rule {
    display: inline-block;
    width: 2.5rem;
    height: 2px;
    border-radius: 9999px;
    background: #0069a8;
  }

  .fc-about__title {
    margin: 0;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #005082;
    text-wrap: balance;
  }

  .fc-about__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: #404750;
  }

  .fc-about__text--lead {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .fc-about__text :global(strong) {
    color: #171c1f;
    font-weight: 600;
  }

  .fc-about__values {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .fc-about__values { grid-template-columns: repeat(3, 1fr); }
  }

  .fc-about__value {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem;
    border-radius: 12px;
    background: #eff4f8;
  }

  .fc-about__value-icon {
    display: inline-flex;
    color: #0069a8;
    margin-bottom: 0.25rem;
  }

  .fc-about__value-title {
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #005082;
  }

  .fc-about__value-body {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #5b6572;
  }

  .fc-about__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.8rem 1.4rem;
    border-radius: 10px;
    background: #005082;
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease;
  }

  .fc-about__cta:hover {
    background: #0069a8;
    transform: translateY(-1px);
  }

  .fc-about__media {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .fc-about__frame {
    border-radius: 12px;
    overflow: hidden;
    height: clamp(20rem, 36vw, 28.75rem);
    box-shadow: 0 12px 32px -12px rgba(8, 46, 82, 0.3);
  }

  .fc-about__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fc-about__quote {
    position: absolute;
    left: -0.5rem;
    bottom: 0;
    margin: 0;
    max-width: 22rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.15rem;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 16px 40px -12px rgba(8, 46, 82, 0.32);
  }

  @media (min-width: 640px) {
    .fc-about__quote { left: -2rem; max-width: 24rem; }
  }

  .fc-about__quote-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: #cfe5ff;
    color: #0069a8;
    flex-shrink: 0;
  }

  .fc-about__quote blockquote {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    font-style: italic;
    color: #171c1f;
  }

  .fc-about__quote-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .fc-about__quote figcaption {
    margin-top: 0.4rem;
    font-family: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: #005082;
  }
</style>
