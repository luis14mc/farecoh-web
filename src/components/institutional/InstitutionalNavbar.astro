---
import FarecohLogo from "@/components/layout/FarecohLogo.astro";
import { FARECOH_METADATA } from "@/data/farecoh";
import { logoAlt } from "@/data/logos";

interface Props {
  readonly active?: "home" | "about" | "programs" | "donations";
  readonly transparent?: boolean;
}

const { active = "home", transparent = false } = Astro.props;

const path = Astro.url.pathname;
const resolveActive = (): Props["active"] => {
  if (path === "/") return "home";
  if (path.startsWith("/sobre-nosotros")) return "about";
  if (path.startsWith("/programas")) return "programs";
  if (path.startsWith("/donaciones")) return "donations";
  return active;
};

const resolved = resolveActive();

const navItems: ReadonlyArray<{
  readonly label: string;
  readonly href: string;
  readonly key: NonNullable<Props["active"]>;
}> = [
  { label: "Inicio", href: "/", key: "home" },
  { label: "Nosotros", href: "/sobre-nosotros", key: "about" },
  { label: "Programas", href: "/programas", key: "programs" },
  { label: "Donaciones", href: "/donaciones", key: "donations" },
];
---

<header
  class={`inst-nav ${transparent ? "inst-nav--transparent" : ""}`}
  id="main-header"
>
  <a href="/" class="inst-nav__brand" aria-label={`${FARECOH_METADATA.acronym} — Inicio`}>
    <FarecohLogo variant="stacked" theme="color" size="nav" loading="eager" />
  </a>

  <nav aria-label="Navegación institucional" class="inst-nav__list-wrap">
    <ul class="inst-nav__list">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="inst-nav__link"
              aria-current={resolved === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="inst-nav__actions">
    <a
      href="/donaciones"
      class="inst-cta inst-cta--solid inst-nav__cta"
      aria-label="Donar a FARECOH"
    >
      Donar
      <span class="inst-cta__arrow" aria-hidden="true"></span>
    </a>
    <button
      type="button"
      class="inst-nav__menu-btn"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="inst-mobile-panel"
      data-inst-menu-open
    >
      <svg
        width="18"
        height="12"
        viewBox="0 0 18 12"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M0 1h18M0 6h18M0 11h12" stroke="currentColor" stroke-width="1.25" />
      </svg>
    </button>
  </div>
</header>

<div
  class="inst-mobile-panel"
  id="inst-mobile-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
  data-inst-mobile-panel
  data-open="false"
>
  <button
    type="button"
    class="inst-mobile-panel__close"
    aria-label="Cerrar menú"
    data-inst-menu-close
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.25" />
    </svg>
  </button>
  <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1.5rem;">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="inst-nav__link"
            style="font-size:1.25rem;padding:0;"
            aria-current={resolved === item.key ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <a
    href="/donaciones"
    class="inst-cta inst-cta--solid"
    style="margin-top:1rem;justify-content:center;"
  >
    Donar
    <span class="inst-cta__arrow" aria-hidden="true"></span>
  </a>
</div>
