---
import type { StrategicPartner } from "@/data/farecoh";

interface Props {
  readonly eyebrow: string;
  readonly headline: string;
  readonly accent?: string;
  readonly partners: readonly StrategicPartner[];
}

const { eyebrow, headline, accent, partners } = Astro.props;

const regionLabels: Record<string, string> = {
  multilateral: "Cooperación multilateral",
  americas: "Américas",
  europe: "Europa",
  "central-america": "Centroamérica",
};

const regionColors: Record<string, string> = {
  multilateral: "var(--color-brand-blue)",
  americas: "var(--color-brand-cyan)",
  europe: "var(--color-accent-plum)",
  "central-america": "var(--color-accent-ruby)",
};

const partnerCount = String(partners.length).padStart(2, "0");
---

<section class="partners-mural" data-reveal-section aria-labelledby="partners-title">
  <div class="partners-mural__grid">
    <aside class="partners-mural__rail" aria-hidden="true">
      <span class="partners-mural__rail-eyebrow">Alianzas</span>
      <span class="partners-mural__rail-num">{partnerCount}</span>
      <span class="partners-mural__rail-line"></span>
      <span class="partners-mural__rail-meta">Cooperantes</span>
    </aside>

    <div class="partners-mural__main">
      <header class="partners-mural__head">
        <p class="tag partners-mural__eyebrow" data-reveal>
          <span class="bar" aria-hidden="true"></span>
          {eyebrow}
        </p>
        <h2 id="partners-title" class="partners-mural__headline" data-reveal data-reveal-delay="120">
          {headline}
          {accent && <span class="partners-mural__accent">{accent}</span>}
        </h2>
      </header>

      <ol class="partners-mural__list" role="list">
        {partners.map((partner, index) => {
          const num = String(index + 1).padStart(2, "0");
          const regionColor = regionColors[partner.region ?? ""] ?? "var(--color-primary-base)";
          return (
            <li
              class="partners-mural__item"
              data-reveal
              data-reveal-delay={200 + index * 100}
              role="listitem"
              style={`--region-accent: ${regionColor};`}
            >
              <span class="partners-mural__num">{num}</span>
              <div class="partners-mural__copy">
                <h3 class="partners-mural__name">{partner.name}</h3>
                {partner.entity && <p class="partners-mural__entity">{partner.entity}</p>}
                {partner.type && <p class="partners-mural__type">{partner.type}</p>}
              </div>
              <span class="partners-mural__region" aria-hidden="true">
                {regionLabels[partner.region ?? ""] ?? partner.region}
              </span>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .partners-mural {
    position: relative;
    background: var(--color-bg-canvas);
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .partners-mural__grid {
    width: min(100% - calc(var(--gutter) * 2), var(--shell));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .partners-mural__grid {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  /* Rail numérico lateral */
  .partners-mural__rail {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .partners-mural__rail {
      display: flex;
    }
  }

  .partners-mural__rail-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-accent-ruby);
  }

  .partners-mural__rail-num {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-accent-ruby);
  }

  .partners-mural__rail-line {
    width: 1px;
    height: 4rem;
    background: var(--color-accent-ruby);
    opacity: 0.5;
  }

  .partners-mural__rail-meta {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--color-text-secondary);
  }

  /* Main */
  .partners-mural__main {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .partners-mural__head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .partners-mural__eyebrow {
    color: var(--color-accent-ruby);
    margin: 0;
  }

  .partners-mural__headline {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw + 1rem, 3rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 22ch;
  }

  .partners-mural__accent {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent-ruby);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.4;
  }

  /* Lista de partners */
  .partners-mural__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .partners-mural__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .partners-mural__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem 1.35rem;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-top: 2px solid var(--region-accent);
    border-radius: 2px;
    transition: box-shadow 280ms ease, transform 280ms ease, border-color 280ms ease;
  }

  .partners-mural__item:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  .partners-mural__num {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--region-accent);
    text-align: left;
  }

  .partners-mural__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .partners-mural__name {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.008em;
    margin: 0;
    color: var(--color-text-primary);
  }

  .partners-mural__entity {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .partners-mural__type {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-plum);
    margin: 0;
  }

  .partners-mural__region {
    font-family: var(--font-heading);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--region-accent);
    background: color-mix(in srgb, var(--region-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--region-accent) 25%, transparent);
    align-self: flex-start;
    margin-top: auto;
    padding: 0.35rem 0.65rem;
    border-radius: 2px;
    white-space: nowrap;
  }
</style>