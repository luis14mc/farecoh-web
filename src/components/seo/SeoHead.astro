---
import { absoluteUrl, canonicalFromPath, ROBOTS_INDEX, ROBOTS_NOINDEX } from "@/lib/seo";
import {
  breadcrumbJsonLd,
  organizationJsonLd,
  SEO_DEFAULT_IMAGE,
  SEO_IMAGE_HEIGHT,
  SEO_IMAGE_WIDTH,
  webSiteJsonLd,
} from "@/data/seo";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Migas de pan (sin "Inicio", se agrega solo). */
  breadcrumbs?: ReadonlyArray<{ name: string; path: string }>;
}

const {
  title,
  description,
  canonicalPath,
  image = SEO_DEFAULT_IMAGE,
  imageAlt,
  ogType = "website",
  noindex = false,
  jsonLd,
  breadcrumbs,
} = Astro.props;

const canonical = canonicalPath ? canonicalFromPath(canonicalPath) : canonicalFromPath(Astro.url.pathname);
const ogImage = image.startsWith("http") ? image : absoluteUrl(image);
const robots = noindex ? ROBOTS_NOINDEX : ROBOTS_INDEX;
const isDefaultImage = image === SEO_DEFAULT_IMAGE;
const altText = imageAlt ?? title;
const pageBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdBlocks = noindex
  ? pageBlocks
  : [
      organizationJsonLd(),
      webSiteJsonLd(),
      ...(breadcrumbs?.length ? [breadcrumbJsonLd(breadcrumbs)] : []),
      ...pageBlocks,
    ];
---

<meta name="description" content={description} />
<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonical} />}

<meta property="og:locale" content="es_LA" />
<meta property="og:site_name" content="FARECOH" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={altText} />
{isDefaultImage && <meta property="og:image:width" content={String(SEO_IMAGE_WIDTH)} />}
{isDefaultImage && <meta property="og:image:height" content={String(SEO_IMAGE_HEIGHT)} />}
{isDefaultImage && <meta property="og:image:type" content="image/jpeg" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={altText} />

{
  jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}
