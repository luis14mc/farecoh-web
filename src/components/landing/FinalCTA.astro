---
import { homeFinalCta } from "@/data/home";
---

<section class="reveal-section landing-section py-24 lg:py-32 bg-[#fcfbfa]">
  <div class="landing-shell">
    <div class="bg-[#091118] text-white p-10 sm:p-16 lg:p-20 border border-white/10">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#04B2D9] mb-4">
          Súmate a la transformación
        </p>

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-6 leading-[1.12]">
          {homeFinalCta.title}
        </h2>

        <p class="text-base sm:text-lg leading-relaxed text-white/80 mb-10 max-w-2xl font-normal">
          {homeFinalCta.body}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href={homeFinalCta.href}
            class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-[#0378A6] px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#04B2D9] hover:text-[#011e2a] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#04B2D9]"
          >
            {homeFinalCta.cta}
          </a>
          <a
            href="/#concierto-benefico"
            class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-white/20 bg-white/[0.04] px-8 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/10 hover:border-white/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            Concierto Benéfico 2026
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
