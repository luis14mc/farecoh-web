---
import { homeWhatWeDo } from "@/data/home";
---

<section id="programas" class="reveal-section landing-section bg-surface-container-low/30 py-20 lg:py-28 border-y border-outline-variant/30">
  <div class="landing-shell">
    <div class="mx-auto max-w-3xl text-center mb-16">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3.5 py-1.5">
        <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-primary">{homeWhatWeDo.label}</span>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl lg:text-5xl leading-tight mb-4">
        {homeWhatWeDo.title}
      </h2>
      <p class="text-base sm:text-lg leading-relaxed text-on-surface-variant max-w-2xl mx-auto">
        {homeWhatWeDo.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {homeWhatWeDo.items.map((program, index) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-primary/40 hover:shadow-xl">
          <div class="relative aspect-[16/10] w-full overflow-hidden bg-surface-container">
            <img
              src={program.image}
              alt={`Fotografía del programa ${program.title} de FARECOH`}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60 transition-opacity duration-300 group-hover:opacity-40" aria-hidden="true"></div>
            <span class="absolute top-4 left-4 inline-flex items-center justify-center rounded-full bg-black/60 backdrop-blur-md px-3 py-1 text-xs font-bold text-white shadow-sm">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>

          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <h3 class="text-xl font-bold tracking-tight text-on-surface mb-3 transition-colors duration-200 group-hover:text-primary">
              {program.title}
            </h3>
            <p class="text-sm leading-relaxed text-on-surface-variant flex-1">
              {program.description}
            </p>
            <div class="mt-6 pt-4 border-t border-outline-variant/40 flex items-center justify-between">
              <span class="text-xs font-semibold text-primary inline-flex items-center gap-1 group-hover:underline">
                Programa activo
              </span>
              <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
