---
import { FARECOH_DATA } from "@/data/farecoh";
---

<section id="programas" class="reveal-section landing-section bg-white py-24 lg:py-32 border-b border-[#e4e4e7]">
  <div class="landing-shell">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Columna Izquierda: Introducción Editorial Pegajosa (Sticky Context) -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <span class="text-xs font-mono font-bold uppercase tracking-[0.22em] text-[#0378A6] block mb-3">
            02 / OFERTA FORMATIVA
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#18181B] leading-tight mb-4">
            Programas sistemáticos de formación y arte
          </h2>
          <p class="text-base text-[#3f3f46] leading-relaxed mb-6">
            Procesos pedagógicos colectivos que abarcan desde la estimulación temprana en bebés hasta orquestas sinfónicas juveniles y coros para personas con capacidades comprometidas.
          </p>
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#0378A6]">
            <span class="h-2 w-2 rounded-full bg-[#04B2D9]"></span>
            <span>4 Programas Oficiales Activos</span>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Índice Editorial sin Cajas Cuadradas (Open List Layout) -->
      <div class="lg:col-span-8 divide-y divide-[#e4e4e7] border-y border-[#e4e4e7]">
        {FARECOH_DATA.programs.map((program) => (
          <article class="group py-8 lg:py-10 transition-colors duration-200 hover:bg-[#fcfbfa] px-2 sm:px-4 -mx-2 sm:-mx-4">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-sm font-bold text-[#0378A6] tracking-wider">
                  {program.tag}
                </span>
                <span class="text-xs font-bold uppercase tracking-[0.14em] text-[#71717a]">
                  {program.category}
                </span>
              </div>
              <span class="inline-flex items-center gap-1.5 self-start sm:self-auto rounded-full bg-[#f1f3f5] px-3 py-0.5 text-xs font-semibold text-[#18181B] border border-[#e4e4e7]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#04B2D9]"></span>
                {program.badge}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#18181B] mb-3 group-hover:text-[#0378A6] transition-colors">
              {program.title}
            </h3>

            <p class="text-base leading-relaxed text-[#3f3f46] max-w-2xl font-normal">
              {program.description}
            </p>
          </article>
        ))}
      </div>

    </div>

  </div>
</section>
