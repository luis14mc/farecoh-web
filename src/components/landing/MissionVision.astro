---
import { homeMissionVision } from "@/data/home";
---

<section class="reveal-section landing-section bg-surface py-20 lg:py-24">
  <div class="landing-shell grid grid-cols-1 gap-8 md:grid-cols-2">
    <article class="group relative rounded-2xl border border-primary/20 bg-gradient-to-br from-surface-container-lowest to-surface-container-low/60 p-8 sm:p-10 shadow-sm transition-all duration-300 hover:border-primary/40 hover:shadow-md">
      <div class="mb-6 flex items-center justify-between">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3.5 py-1.5">
          <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-primary">{homeMissionVision.mission.label}</span>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
      </div>
      <p class="text-xl sm:text-2xl font-bold leading-snug tracking-tight text-on-surface">
        "{homeMissionVision.mission.text}"
      </p>
    </article>

    <article class="group relative rounded-2xl border border-brand-500/20 bg-gradient-to-br from-surface-container-lowest to-surface-container-low/60 p-8 sm:p-10 shadow-sm transition-all duration-300 hover:border-brand-500/40 hover:shadow-md">
      <div class="mb-6 flex items-center justify-between">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/5 px-3.5 py-1.5">
          <span class="h-2 w-2 rounded-full bg-brand-500" aria-hidden="true"></span>
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-brand-700">{homeMissionVision.vision.label}</span>
        </div>
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-700">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
      </div>
      <p class="text-xl sm:text-2xl font-bold leading-snug tracking-tight text-on-surface">
        "{homeMissionVision.vision.text}"
      </p>
    </article>
  </div>
</section>
