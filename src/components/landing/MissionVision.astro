---
import { FARECOH_DATA } from "@/data/farecoh";
---

<section id="mision-vision" class="reveal-section landing-section bg-[#fcfbfa] py-24 lg:py-32 border-b border-[#e4e4e7]">
  <div class="landing-shell">
    
    <!-- Editorial Lead Statement -->
    <div class="mb-20 max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0378A6] mb-4">
        Filosofía Institucional &bull; FARECOH
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#18181B] leading-[1.15] text-balance">
        La música no es únicamente una disciplina estética; es un modelo probado de prevención, dignidad y rescate social.
      </h2>
    </div>

    <!-- Comparative Editorial Manifesto (Open Layout, Zero Boxy Cliché) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 pt-6">
      
      <!-- Misión -->
      <div class="flex flex-col justify-between border-t-2 border-[#0378A6] pt-8">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-[0.22em] text-[#0378A6] mb-4 block">
            01 / MISIÓN INSTITUCIONAL
          </span>
          <blockquote class="text-xl sm:text-2xl font-normal leading-relaxed text-[#18181B] tracking-tight">
            "{FARECOH_DATA.identity.mission}"
          </blockquote>
        </div>

        <div class="mt-10 pt-6 border-t border-[#e4e4e7] flex flex-wrap gap-2 text-xs font-semibold text-[#71717a]">
          <span class="px-3 py-1 rounded-full bg-[#f1f3f5] text-[#18181B]">Excelencia Artística</span>
          <span class="px-3 py-1 rounded-full bg-[#f1f3f5] text-[#18181B]">Desarrollo Humano</span>
          <span class="px-3 py-1 rounded-full bg-[#f1f3f5] text-[#18181B]">Prevención Social</span>
        </div>
      </div>

      <!-- Visión -->
      <div class="flex flex-col justify-between border-t-2 border-[#8A038C] pt-8">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-[0.22em] text-[#8A038C] mb-4 block">
            02 / VISIÓN DE FUTURO
          </span>
          <blockquote class="text-xl sm:text-2xl font-normal leading-relaxed text-[#18181B] tracking-tight">
            "{FARECOH_DATA.identity.vision}"
          </blockquote>
        </div>

        <div class="mt-10 pt-6 border-t border-[#e4e4e7] flex flex-wrap gap-2 text-xs font-semibold text-[#71717a]">
          <span class="px-3 py-1 rounded-full bg-[#f1f3f5] text-[#18181B]">Modelo Pedagógico</span>
          <span class="px-3 py-1 rounded-full bg-[#f1f3f5] text-[#18181B]">Inclusión Social</span>
          <span class="px-3 py-1 rounded-full bg-[#f1f3f5] text-[#18181B]">Liderazgo Nacional</span>
        </div>
      </div>

    </div>
  </div>
</section>
