---
import { homeHero } from "@/data/home";
import LandingButton from "@/components/landing/LandingButton.astro";
import FarecohLogo from "@/components/layout/FarecohLogo.astro";
---

<section class="hero-parallax relative flex min-h-[92vh] w-full items-end overflow-hidden bg-brand-neutral md:min-h-[92vh] md:items-center">
  <div class="hero-parallax__media absolute inset-0 z-0 overflow-hidden">
    <div class="parallax-layer" data-parallax data-parallax-speed="0.42" data-parallax-scale="1.14">
      <img
        class="h-full w-full object-cover object-center"
        src={homeHero.image}
        alt={homeHero.imageAlt}
        fetchpriority="high"
      />
    </div>
    <div class="hero-editorial absolute inset-0"></div>
  </div>

  <div class="landing-section relative z-10 w-full pb-12 pt-32 md:pb-16 md:pt-16">
    <div class="landing-shell hero-content max-w-4xl text-white">
      <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-white/20 bg-black/40 px-4 py-2 backdrop-blur-md">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-400 animate-pulse" aria-hidden="true"></span>
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-white/90">Música · Educación · Transformación Social</span>
      </div>

      <div class="mb-6 flex items-center gap-4">
        <FarecohLogo variant="stacked" theme="white" size="hero" loading="eager" />
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl leading-[1.08] mb-6 drop-shadow-sm">
        {homeHero.title}
      </h1>

      <p class="text-lg md:text-xl font-normal leading-relaxed text-white/90 max-w-2xl mb-4">
        {homeHero.subtitle}
      </p>

      <p class="text-sm md:text-base font-medium text-brand-400 max-w-2xl mb-8">
        {homeHero.body}
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <LandingButton href="/#concierto-benefico" variant="primary" class="rounded-xl shadow-lg hover:shadow-cyan-500/25">
          {homeHero.ctaEvent}
        </LandingButton>
        <LandingButton href="/#historia" variant="secondary" class="rounded-xl backdrop-blur-sm">
          {homeHero.ctaStory}
        </LandingButton>
      </div>
    </div>
  </div>
</section>
