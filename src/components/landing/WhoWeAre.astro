---
import { homeAbout } from "@/data/home";
---

<section id="historia" class="reveal-section landing-section bg-surface relative overflow-hidden py-20 lg:py-28">
  <div class="landing-shell grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6 lg:pr-6">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3.5 py-1.5">
        <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-primary">{homeAbout.label}</span>
      </div>
      
      <h2 class="text-3xl font-extrabold tracking-tight text-on-surface sm:text-4xl lg:text-5xl leading-tight mb-6">
        {homeAbout.title}
      </h2>

      <p class="text-lg leading-relaxed text-on-surface-variant mb-6 font-medium">
        {homeAbout.body}
      </p>

      <p class="text-base leading-relaxed text-on-surface-variant/90 mb-8">
        {homeAbout.bodySecondary}
      </p>

      <div class="rounded-xl border border-outline-variant/60 bg-surface-container-lowest p-6 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-on-surface">Música que transforma realidades</h3>
            <p class="mt-1 text-sm text-on-surface-variant leading-relaxed">
              Formación orquestal de excelencia enfocada en la dignidad, autoestima y desarrollo integral de la juventud hondureña.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="relative lg:col-span-6">
      <div class="relative mx-auto max-w-lg lg:max-w-none">
        <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-brand-400/20 via-primary/10 to-transparent blur-xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container shadow-2xl">
          <div class="aspect-[4/3] w-full overflow-hidden">
            <img
              src={homeAbout.image}
              alt={homeAbout.imageAlt}
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="border-t border-outline-variant/40 bg-surface-container-lowest p-5 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Desde 2013</span>
            <span class="text-xs font-semibold text-primary">Valle de Ángeles, Honduras</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
