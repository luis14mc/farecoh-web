---
import { homeAbout } from "@/data/home";
---

<section id="historia" class="reveal-section landing-section bg-white relative overflow-hidden py-24 lg:py-32 border-b border-[#e4e4e7]">
  <div class="landing-shell grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-20">
    
    <!-- Columna Narrativa -->
    <div class="lg:col-span-6">
      <span class="text-xs font-mono font-bold uppercase tracking-[0.22em] text-[#0378A6] block mb-3">
        01 / NUESTRA TRAYECTORIA
      </span>
      
      <h2 class="text-3xl font-extrabold tracking-tight text-[#18181B] sm:text-4xl lg:text-5xl leading-[1.12] mb-6">
        {homeAbout.title}
      </h2>

      <p class="text-lg leading-relaxed text-[#18181B] mb-5 font-normal">
        {homeAbout.body}
      </p>

      <p class="text-base leading-relaxed text-[#3f3f46] mb-8 font-normal">
        {homeAbout.bodySecondary}
      </p>

      <!-- Editorial Pull Quote (Sin cajas repetitivas) -->
      <div class="border-l-2 border-[#0378A6] pl-5 py-2 my-8">
        <p class="text-base font-medium text-[#18181B] leading-relaxed">
          "La práctica orquestal y coral colectiva enseña a escucharse mutuamente, forjando ciudadanía pacífica, disciplina y autoestima en la juventud hondureña."
        </p>
        <p class="mt-2 text-xs font-mono font-bold uppercase tracking-wider text-[#0378A6]">
          Filosofía Pedagógica &bull; Valle de Ángeles
        </p>
      </div>

      <div class="flex items-center gap-8 pt-4 text-xs font-mono text-[#71717a] uppercase tracking-wider">
        <div>
          <span class="block text-2xl font-extrabold text-[#0378A6] font-sans">2013</span>
          <span>Año de Fundación</span>
        </div>
        <div class="h-8 w-[1px] bg-[#e4e4e7]"></div>
        <div>
          <span class="block text-2xl font-extrabold text-[#0378A6] font-sans">100%</span>
          <span>Compromiso Gratuito</span>
        </div>
        <div class="h-8 w-[1px] bg-[#e4e4e7]"></div>
        <div>
          <span class="block text-2xl font-extrabold text-[#0378A6] font-sans">+10</span>
          <span>Años de Impacto</span>
        </div>
      </div>
    </div>

    <!-- Columna Visual Editorial -->
    <div class="relative lg:col-span-6">
      <div class="relative mx-auto max-w-lg lg:max-w-none">
        <div class="relative overflow-hidden rounded-2xl bg-[#0a151d] shadow-xl aspect-[4/3]">
          <img
            src={homeAbout.image}
            alt={homeAbout.imageAlt}
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs font-medium backdrop-blur-md bg-black/40 px-4 py-2.5 rounded-xl border border-white/10">
            <span>Sede Central &bull; Valle de Ángeles, Honduras</span>
            <span class="font-mono text-[#04B2D9]">EST. 2013</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
