---
import { homeImpact } from "@/data/home";

type ImpactStat =
  | { kind: "number"; prefix: string; target: number; display: string }
  | { kind: "text"; text: string };

function parseImpactValue(value: string): ImpactStat {
  const match = value.match(/^(\+?)(\d+)$/);
  if (!match) return { kind: "text", text: value };
  const prefix = match[1];
  const target = Number(match[2]);
  return { kind: "number", prefix, target, display: `${prefix}0` };
}

const stats = homeImpact.items.map(([value, label]) => ({
  label,
  parsed: parseImpactValue(value),
}));
---

<section id="impacto" class="reveal-section landing-impact-panel relative overflow-hidden bg-gradient-to-b from-[#181516] via-[#1f1b1c] to-[#181516] text-white py-24 lg:py-32">
  <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-brand-400/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-40 -right-40 h-96 w-96 rounded-full bg-primary/15 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="landing-shell relative z-10">
    <header class="mb-16 max-w-3xl">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-400/30 bg-brand-400/10 px-3.5 py-1.5 backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-brand-400" aria-hidden="true"></span>
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-brand-400">{homeImpact.label}</span>
      </div>
      <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl leading-tight mb-4">
        {homeImpact.title}
      </h2>
      <p class="text-base sm:text-lg leading-relaxed text-white/85">
        {homeImpact.body}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map(({ label, parsed }, index) => (
        <article
          class="group rounded-2xl border border-white/10 bg-white/[0.03] p-7 backdrop-blur-sm transition-all duration-300 hover:border-brand-400/40 hover:bg-white/[0.06] hover:-translate-y-1"
          style={`--impact-delay: ${index * 120}ms`}
        >
          <p
            class="impact-stat-value text-4xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight text-brand-400 transition-colors duration-200 group-hover:text-white"
            data-impact-stat
            data-impact-index={index}
            {...parsed.kind === "number"
              ? { "data-target": parsed.target, "data-prefix": parsed.prefix }
              : { "data-text": parsed.text }}
          >
            {parsed.kind === "number" ? parsed.display : parsed.text}
          </p>
          <p class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-white/70 leading-relaxed">
            {label}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function animateImpactStats() {
    const section = document.querySelector(".landing-impact-panel");
    if (!section) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let played = false;

    if (prefersReducedMotion) {
      section.querySelectorAll("[data-impact-stat]").forEach((el) => {
        if (el.dataset.text) {
          el.classList.add("is-counted");
          return;
        }
        el.textContent = `${el.dataset.prefix || ""}${el.dataset.target}`;
        el.classList.add("is-counted");
      });
    }

    function easeOutCubic(t) {
      return 1 - Math.pow(1 - t, 3);
    }

    function runCountUp(el) {
      const target = Number(el.dataset.target);
      const prefix = el.dataset.prefix || "";
      const delay = Number(el.dataset.impactIndex || 0) * 120;

      if (prefersReducedMotion || Number.isNaN(target)) {
        el.textContent = `${prefix}${target}`;
        el.classList.add("is-counted");
        return;
      }

      window.setTimeout(() => {
        const duration = 1800;
        const start = performance.now();

        function tick(now) {
          const progress = Math.min((now - start) / duration, 1);
          const value = Math.round(easeOutCubic(progress) * target);
          el.textContent = `${prefix}${value}`;
          if (progress < 1) {
            requestAnimationFrame(tick);
          } else {
            el.classList.add("is-counted");
          }
        }

        requestAnimationFrame(tick);
      }, delay);
    }

    function play() {
      if (played) return;
      played = true;

      if (prefersReducedMotion) return;

      section.querySelectorAll("[data-impact-stat]").forEach((el) => {
        if (el.dataset.text) {
          window.setTimeout(() => el.classList.add("is-counted"), Number(el.dataset.impactIndex || 0) * 120);
          return;
        }
        runCountUp(el);
      });
    }

    function onVisible() {
      if (!section.classList.contains("is-visible")) return;
      play();
    }

    if (section.classList.contains("is-visible")) {
      play();
      return;
    }

    const observer = new MutationObserver(onVisible);
    observer.observe(section, { attributes: true, attributeFilter: ["class"] });
    onVisible();
  })();
</script>
