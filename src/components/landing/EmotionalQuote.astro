---
import { homeQuote } from "@/data/home";
---

<section class="reveal-section landing-section bg-[#fcfbfa] py-24 lg:py-32 border-b border-[#e4e4e7]">
  <div class="landing-shell">
    <blockquote class="mx-auto max-w-4xl text-center">
      <p class="font-serif text-2xl sm:text-3xl lg:text-4xl font-normal leading-relaxed text-[#18181B] italic mb-6 max-w-3xl mx-auto">
        "{homeQuote.text}"
      </p>
      <footer>
        <cite class="text-sm font-semibold text-[#0378A6] not-italic">
          {homeQuote.signature}
        </cite>
      </footer>
    </blockquote>
  </div>
</section>
