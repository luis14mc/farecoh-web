# Server & Deployment
PORT=4321
PUBLIC_SITE_URL=https://farecoh.org

# PostgreSQL Database (Railway)
DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:5432/railway

# Admin Authentication Session Secret (generate a random 32+ char string)
AUTH_SECRET=farecoh-secret-key-change-this-in-production-random-string


# WhatsApp staff alerts (server-only — never PUBLIC_)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
FARECOH_NOTIFY_WHATSAPP_TO=whatsapp:+504XXXXXXXX

# Meta WhatsApp Cloud API (optional alternative to Twilio)
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_FROM=whatsapp:+504XXXXXXXX
