PUBLIC_SITE_URL=https://farecoh.org

# Postgres — set by Railway Postgres service or external provider
DATABASE_URL=postgres://user:password@host:5432/farecoh

# Session cookie signing
SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin user (only used by `pnpm db:seed:admin`)
ADMIN_EMAIL=admin@farecoh.org
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=FARECOH Admin

# Server runtime (Railway injects PORT automatically)
HOST=0.0.0.0
PORT=8080

# WhatsApp staff alerts (server-only — never PUBLIC_)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
FARECOH_NOTIFY_WHATSAPP_TO=whatsapp:+504XXXXXXXX

# Meta WhatsApp Cloud API (optional alternative to Twilio)
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_FROM=whatsapp:+504XXXXXXXX
