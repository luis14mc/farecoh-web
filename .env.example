# Server & Deployment
PORT=4321
PUBLIC_SITE_URL=https://farecoh.org

# PostgreSQL Database (Railway)
DATABASE_URL=postgresql://postgres:password@localhost:5432/farecoh

# Admin Authentication Session Secret (generate a random 32+ char string)
AUTH_SECRET=


# WhatsApp staff alerts (server-only — never PUBLIC_)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
FARECOH_NOTIFY_WHATSAPP_TO=whatsapp:+504XXXXXXXX

# Meta WhatsApp Cloud API (optional alternative to Twilio)
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_FROM=whatsapp:+504XXXXXXXX

# En Railway, configura HOST=0.0.0.0 y referencia DATABASE_URL como
# ${{Postgres.DATABASE_URL}}

# Admin inicial: `pnpm db:seed` lo crea solo si no existe (nunca cambia una contraseña existente)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador FARECOH

# Solo para importar datos una vez: URL Postgres de Supabase (Session pooler)
# SOURCE_DATABASE_URL=
